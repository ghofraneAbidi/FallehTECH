{% extends 'front_base.html.twig' %}

{% block title %}Messenger{% endblock %}

{% block body %}

<!-- Display connected user -->
        

    <div class="container1">
    <!-- Chat List -->
    <aside class="chat-list">
        <input type="text" placeholder="Search..." class="search-bar">
        
        <div class="user-list">
            {% for user in users %}
                <div class="chat-item {% if user.id in unreadMessages %}unread{% endif %}" 
                     onclick="loadMessages({{ user.id }}, '{{ user.nom }}')">
                    <div class="avatar">
                        <img src="{{ asset('img/user.jpg') }}" alt="User Avatar" class="user-avatar">
                    </div>
                    <div class="chat-info">
                        <h4>{{ user.nom }}</h4>
                        <p id="last-message-{{ user.id }}">Loading...</p>
                    </div>
                    <span class="notification-badge" id="notif-{{ user.id }}" style="display: none;">0</span>
                </div>
            {% endfor %}
        </div>
    </aside>

    <!-- Chat Window -->
    <main class="chat-window">
        <div class="chat-header">
           <button class="back-button" onclick="goBack()">← Back</button>

            <h3 id="selected-user-name">Select a user</h3>
        </div>

        <div class="chat-content" id="chat-box">
            <p class="no-chat">Select a user to start chatting.</p>
        </div>

        <!-- Message Input -->
        <div class="message-input">
            <input type="text" id="message" placeholder="Type a message..." disabled>
            <button type="button" id="send-btn" disabled>Send</button>
        </div>
    </main>
</div>
<style>


/* General Styles */
body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
    background: #f5f5f5;
}

/* Main Container */
.container1 {
    display: flex;
    width: 100%;
    height: 75vh;
    background: #fff;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
    border: 1px solid #ddd;
}

/* Sidebar */
.sidebar {
    width: 60px;
    background: #3b4cb8;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 20px;
}

.nav-icon {
    width: 30px;
    height: 30px;
    background: rgba(255, 255, 255, 0.2);
    margin: 10px 0;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.3s;
}

.nav-icon.active {
    background: #ffffff;
}

/* Chat List */
.chat-list {
    width: 300px;
    background: #f4f4f4;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    overflow-y: auto;
    border-right: 1px solid #ddd;
}

.search-bar {
    width: 100%;
    padding: 10px;
    border-radius: 20px;
    border: 1px solid #ddd;
    outline: none;
    background: #fff;
}

/* Chat Items */
.chat-item {
    display: flex;
    align-items: center;
    background: #ffffff;
    padding: 10px;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.3s ease-in-out;
    position: relative;
}

.chat-item:hover {
    background: #e3e3e3;
}

.chat-item.unread {
    background-color: #d1d1d1;
    font-weight: bold;
}

/* Avatar */
.avatar {
    width: 40px;
    height: 40px;
    background: #ddd;
    border-radius: 50%;
    overflow: hidden;
    margin-right: 10px;
}

.avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

/* Chat Info */
.chat-info {
    flex: 1;
}

.chat-info h4 {
    font-size: 14px;
    margin-bottom: 5px;
}

.chat-info p {
    font-size: 12px;
    color: #777;
}

/* Notification Badge */
.notification-badge {
    background: red;
    color: white;
    border-radius: 50%;
    padding: 3px 6px;
    font-size: 12px;
    position: absolute;
    top: 10px;
    right: 10px;
    display: none;
}

/* Chat Window */
.chat-window {
    flex: 1;
    background: #ffffff;
    display: flex;
    flex-direction: column;
    border-left: 1px solid #ddd;
}

/* Chat Header */
.chat-header {
    padding: 15px;
    font-size: 18px;
    border-bottom: 1px solid #ddd;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #f9f9f9;
}

/* Chat Content */
.chat-content {
    flex: 1;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    overflow-y: auto;
}

/* Messages */
.message {
    max-width: 60%;
    padding: 10px;
    border-radius: 10px;
    font-size: 14px;
    word-wrap: break-word;
}

.message.received {
    background: #f1f1f1;
    align-self: flex-start;
}

.message.sent {
    background: #63b524;
    color: white;
    align-self: flex-end;
}

/* Message Input */
.message-input {
    display: flex;
    padding: 10px;
    border-top: 1px solid #ddd;
    background: #f9f9f9;
}

.message-input input {
    flex: 1;
    padding: 10px;
    border: 1px solid #ddd;
    border-radius: 5px;
    outline: none;
    background: #f4f4f4;
}

.message-input button {
    margin-left: 10px;
    padding: 10px 15px;
    border: none;
    background: #63b524;
    color: white;
    border-radius: 5px;
    cursor: pointer;
    transition: background 0.3s;
}

.message-input button:hover {
    background: #558f1b;
}

.message-input button:disabled {
    background: #bbb;
    cursor: not-allowed;
}

/* Mobile Responsiveness */
@media (max-width: 768px) {
    .container1 {
        flex-direction: column;
        height: 100vh;
    }

    .chat-list {
        width: 100%;
        max-width: none;
        display: none;
        position: absolute;
        top: 0;
        left: 0;
        height: 100vh;
        z-index: 10;
    }

    .chat-list.active {
        display: block;
    }

    .chat-window {
        width: 100%;
    }

    .back-button {
        display: block;
    }
}


</style>


<!-- JavaScript (Fixing Messaging Issues) -->
<script>



function goBack() {
    window.location.href = "/candidature/ouvrier/offers"; // Redirects to the specified route
}

document.addEventListener("DOMContentLoaded", function () {
    let selectedUserId = null;
    const sendBtn = document.getElementById("send-btn");
    const messageInput = document.getElementById("message");
    const chatBox = document.getElementById("chat-box");
    const senderId = {{ testUser.id|json_encode|raw }};
    const selectedUserName = document.getElementById("selected-user-name");

    if (sendBtn) sendBtn.addEventListener("click", sendMessage);

    // Function to load messages dynamically
  window.loadMessages = function(userId, userName) {
    selectedUserId = userId;
    messageInput.disabled = false;
    sendBtn.disabled = false;
    messageInput.placeholder = "Type a message...";
    selectedUserName.innerText = `Chatting with ${userName}`;

    fetchMessages(); // Load messages initially
    markMessagesAsRead(userId); // Mark messages as read for this conversation
    startAutoRefresh(); // Start real-time updates

    // Remove unread class dynamically when the user opens the chat
    let chatItem = document.querySelector(`.chat-item[onclick="loadMessages(${userId}, '${userName}')"]`);
    if (chatItem) {
        chatItem.classList.remove("unread");
    }

    // Get last message preview from the chat list
    let lastMessageElement = document.getElementById(`last-message-${userId}`);
    if (lastMessageElement) {
        lastMessageElement.textContent = "Loading..."; // Temporarily show loading text
    }

    // Fetch the last message and update the preview
    fetch(`/messaging/conversation/${userId}`)
        .then(response => response.json())
        .then(messages => {
            let lastMessageText = messages.length > 0 ? messages[messages.length - 1].content : "Start Chatting";
            if (lastMessageElement) {
                lastMessageElement.textContent = lastMessageText;
            }
        })
        .catch(error => console.error("Error fetching last message:", error));
};


    function fetchMessages() {
    if (!selectedUserId) return;

    fetch(`/messaging/conversation/${selectedUserId}`)
        .then(response => response.json())
        .then(messages => {
            chatBox.innerHTML = ""; // Clear chat box

            let lastMessageText = "Start Talking"; // Default message if no messages exist

            if (messages.length === 0) {
                chatBox.innerHTML = "<p>No messages yet.</p>";
            } else {
                messages.forEach((message, index) => {
                    let messageDiv = document.createElement("div");
                    messageDiv.classList.add("message");

                    if (message.sender.id === senderId) {
                        messageDiv.classList.add("sent");
                    } else {
                        messageDiv.classList.add("received");
                    }

                    messageDiv.innerHTML = `
                        <p>${message.content}</p>
                        <small>${message.createdAt}</small>
                    `;

                    chatBox.appendChild(messageDiv);

                    // Set last message preview
                    if (index === messages.length - 1) {
                        lastMessageText = message.content;
                    }
                });

                chatBox.scrollTop = chatBox.scrollHeight;
            }

            // Update the last message preview for the user in the chat list
            let lastMessageElement = document.getElementById(`last-message-${selectedUserId}`);
            if (lastMessageElement) {
                lastMessageElement.textContent = lastMessageText;
            }
        })
        .catch(error => console.error("Error loading messages:", error));
}


    function sendMessage() {
        if (!selectedUserId) {
            alert("Please select a user to chat with.");
            return;
        }

        const message = messageInput.value.trim();
        if (message === "") {
            alert("Message cannot be empty!");
            return;
        }

        const requestData = {
            recipient_id: selectedUserId,
            content: message
        };

        fetch('/messaging/send', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify(requestData)
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                fetchMessages(); // Reload messages instantly after sending
                messageInput.value = "";
                fetchUnreadNotifications();
            } else {
                alert("Error: " + (data.error || "Message failed to send!"));
            }
        })
        .catch(error => {
            console.error("Fetch Error:", error);
            alert("An error occurred while sending the message.");
        });
    }

    function markMessagesAsRead(userId) {
        fetch(`/messaging/conversation/${userId}/read`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        }).then(() => {
            let notifElement = document.getElementById(`notif-${userId}`);
            if (notifElement) {
                notifElement.style.display = "none";
            }

            let chatItem = document.querySelector(`.chat-item[onclick="loadMessages(${userId}, 'USER_NAME')"]`);
            if (chatItem) {
                chatItem.classList.remove("unread");
            }
        });
    }

    function fetchUnreadNotifications() {
        fetch('/messaging/notifications/unread')
            .then(response => response.json())
            .then(data => {
                document.querySelectorAll(".notification-badge").forEach(el => {
                    el.style.display = "none";
                });

                data.forEach(notif => {
                    let notifElement = document.getElementById(`notif-${notif.senderId}`);
                    if (notifElement) {
                        notifElement.textContent = notif.unreadCount;
                        notifElement.style.display = notif.unreadCount > 0 ? "block" : "none";
                    }
                });
            })
            .catch(error => console.error("Error fetching notifications:", error));
    }

    // Auto-refresh messages and notifications every 5 seconds
    function startAutoRefresh() {
        setInterval(() => {
            if (selectedUserId) {
                fetchMessages();
                fetchUnreadNotifications();
            }
        }, 5000);
    }
});

function fetchLastMessagesForUsers() {
    document.querySelectorAll(".chat-item").forEach(chatItem => {
        let userId = chatItem.getAttribute("onclick").match(/\d+/)[0]; // Extract userId
        let lastMessageElement = document.getElementById(`last-message-${userId}`);

        fetch(`/messaging/conversation/${userId}`)
            .then(response => response.json())
            .then(messages => {
                let lastMessageText = messages.length > 0 ? messages[messages.length - 1].content : "Start Talking";
                if (lastMessageElement) {
                    lastMessageElement.textContent = lastMessageText;
                }
            })
            .catch(error => console.error(`Error fetching last message for user ${userId}:`, error));
    });
}

// Call this function when the page loads
document.addEventListener("DOMContentLoaded", fetchLastMessagesForUsers);
document.addEventListener("DOMContentLoaded", function () {
    const searchBar = document.querySelector(".search-bar");
    const chatItems = document.querySelectorAll(".chat-item");

    searchBar.addEventListener("input", function () {
        const searchText = searchBar.value.toLowerCase();

        chatItems.forEach(chatItem => {
            const userName = chatItem.querySelector("h4").textContent.toLowerCase();

            if (userName.includes(searchText)) {
                chatItem.style.display = "flex"; // Show matching users
            } else {
                chatItem.style.display = "none"; // Hide non-matching users
            }
        });
    });
});


</script>

{% endblock %}