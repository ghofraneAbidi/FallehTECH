{% extends 'front_base.html.twig' %}

{% block title %}Worker Job Calendar{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1 class="text-center mb-4">Worker Job Calendar</h1>

        <!-- ✅ Alert Messages -->
        <div id="alertMessage" class="alert d-none" role="alert"></div>

        <!-- ✅ Back Button -->
        <button class="btn btn-secondary mb-3" onclick="window.location.href='{{ path('app_ouvrier_offers') }}'">
            ← Back to Job Offers
        </button>

        <!-- ✅ Add Task Button -->
        <button class="btn btn-primary mb-3" id="addTaskBtn">
            <i class="fas fa-plus"></i> Add Task
        </button>

        <!-- ✅ Isolated FullCalendar Container -->
        <div class="calendar-wrapper">
            <div id="calendar"></div>
        </div>
    </div>

    <!-- ✅ Task Modal -->
    <div class="modal fade" id="taskModal" tabindex="-1" aria-labelledby="taskModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="taskModalLabel">Add/Edit Task</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="taskForm">
                        <input type="hidden" id="taskId">
                        <div class="mb-3">
                            <label for="taskTitle" class="form-label">Task Title</label>
                            <input type="text" class="form-control" id="taskTitle" required>
                        </div>
                        <div class="mb-3">
                            <label for="taskStart" class="form-label">Start Date</label>
                            <input type="date" class="form-control" id="taskStart" required>
                        </div>
                        <div class="mb-3">
                            <label for="taskEnd" class="form-label">End Date</label>
                            <input type="date" class="form-control" id="taskEnd" required>
                        </div>
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-check"></i> Save Task
                        </button>
                        <button type="button" class="btn btn-danger d-none" id="deleteTaskBtn">
                            <i class="fas fa-trash"></i> Delete Task
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- ✅ Load FullCalendar Styles (Scoped) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css">

    <!-- ✅ Bootstrap and Other Dependencies -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js"></script>

    <!-- ✅ Scoped CSS Fix -->
    <style>
        /* ✅ Wrap Calendar in its own container to avoid conflicts */
        .calendar-wrapper {
            background: #ffffff;
            padding: 15px;
            border-radius: 8px;
            max-width: 100%;
            overflow-x: auto;
        }

        /* ✅ Prevent FullCalendar from overriding Bootstrap styles */
        .calendar-wrapper .fc {
            font-family: inherit !important;
        }

        /* ✅ FullCalendar Button Fix */
        .calendar-wrapper .fc .fc-button {
            background-color: #007bff !important;
            border-color: #007bff !important;
            color: white !important;
            font-size: 14px;
            padding: 8px 12px;
            border-radius: 5px;
        }

        /* ✅ Fix modal z-index issue */
        .modal-content {
            z-index: 1050 !important;
        }

        /* ✅ Fix navbar background */
        .navbar {
            background-color: white !important;
        }

        /* ✅ Ensure text color remains proper */
        .navbar .nav-link {
            color: green !important;
        }

        /* ✅ Fix footer styles */
        footer {
            background-color: #f8f9fa !important;
            color: #333 !important;
            position: relative;
            width: 100%;
            bottom: 0;
            padding: 20px 0;
            z-index: 1000;
        }

    </style>

    <script>
      document.addEventListener('DOMContentLoaded', function () {
    var calendarEl = document.getElementById('calendar');
    var alertMessage = document.getElementById('alertMessage');
    var taskIdField = document.getElementById('taskId');
    var deleteTaskBtn = document.getElementById('deleteTaskBtn');
    var taskModal = new bootstrap.Modal(document.getElementById('taskModal'));

    // ✅ Get Worker ID dynamically
    var workerId = "{{ impersonated_user.id|default('0') }}"; // Default to '0' if not found

    // ✅ Initialize FullCalendar
    var calendar = new FullCalendar.Calendar(calendarEl, {
        initialView: 'dayGridMonth',
        editable: true,
        eventSources: [
            // ✅ Fetch worker tasks
            {
                url: '/tasks/list',
                method: 'GET',
                failure: function() {
                    showAlert("Failed to load tasks", "danger");
                }
            },
            // ✅ Fetch candidatures and display them in the calendar
            {
                url: `/offre/emploi/travailleur/calendar`, // ✅ Use the correct route
                method: 'GET',
                failure: function(error) {
                    console.error("❌ Failed to load candidatures:", error);
                    showAlert("Failed to load candidatures", "danger");
                }
            }
        ],
        eventClick: function(info) {
            if (info.event.id.startsWith("candidature_")) {
                window.location.href = "/offre/emploi/candidature/show/" + info.event.id.split("_")[1];
            } else {
                openEditModal(info.event);
            }
        }
    });

    calendar.render();

    document.getElementById('addTaskBtn').addEventListener('click', function () {
        resetForm();
        taskModal.show();
    });

    document.getElementById('taskForm').addEventListener('submit', function (e) {
        e.preventDefault();
        saveTask();
    });

    deleteTaskBtn.addEventListener('click', function () {
        deleteTask(taskIdField.value);
    });

    function showAlert(message, type) {
        alertMessage.textContent = message;
        alertMessage.className = `alert alert-${type}`;
        alertMessage.classList.remove('d-none');
        setTimeout(() => alertMessage.classList.add('d-none'), 3000);
    }

    function resetForm() {
        taskIdField.value = "";
        document.getElementById('taskForm').reset();
        deleteTaskBtn.classList.add('d-none');
    }
});

    </script>
{% endblock %}
