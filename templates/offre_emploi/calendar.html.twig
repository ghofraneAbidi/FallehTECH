{% extends 'front_base.html.twig' %}

{% block title %}Job Offers Calendar{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1 class="text-center">Worker Job Calendar</h1>
        
        <!-- ✅ Add Button to Open Modal -->
        <button class="btn btn-primary mb-3" id="addTaskBtn">Add Task</button>

        <!-- ✅ FullCalendar -->
        <div id="calendar"></div>
    </div>

    <!-- ✅ Modal for Adding Tasks -->
    <div class="modal fade" id="taskModal" tabindex="-1" aria-labelledby="taskModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="taskModalLabel">Add Task to Calendar</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="taskForm">
                        <div class="mb-3">
                            <label for="taskTitle" class="form-label">Task Title</label>
                            <input type="text" class="form-control" id="taskTitle" required>
                        </div>
                        <div class="mb-3">
                            <label for="taskStart" class="form-label">Start Date</label>
                            <input type="date" class="form-control" id="taskStart" required>
                        </div>
                        <div class="mb-3">
                            <label for="taskEnd" class="form-label">End Date</label>
                            <input type="date" class="form-control" id="taskEnd" required>
                        </div>
                        <button type="submit" class="btn btn-success">Add Task</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- ✅ Include FullCalendar via CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css">
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js"></script>
    
    <!-- ✅ Include Bootstrap for Modal -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
       document.addEventListener('DOMContentLoaded', function () {
    var calendarEl = document.getElementById('calendar');
    var calendar = new FullCalendar.Calendar(calendarEl, {
        initialView: 'dayGridMonth',
        events: '/tasks/list',  // Load tasks from database
        editable: true,
        eventDrop: function(info) {
            alert('Task moved to ' + info.event.start.toISOString().split('T')[0]);
        },
        eventClick: function(info) {
            alert('Job: ' + info.event.title + '\nStart Date: ' + info.event.start.toISOString().split('T')[0]);
        }
    });
    calendar.render();

    document.getElementById('addTaskBtn').addEventListener('click', function () {
        var taskModal = new bootstrap.Modal(document.getElementById('taskModal'));
        taskModal.show();
    });

    document.getElementById('taskForm').addEventListener('submit', function (e) {
        e.preventDefault();

        var title = document.getElementById('taskTitle').value;
        var startDate = document.getElementById('taskStart').value;
        var endDate = document.getElementById('taskEnd').value;

        if (title && startDate && endDate) {
            fetch('/tasks/add', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ title, start: startDate, end: endDate })
            })
            .then(response => response.json())
            .then(data => {
                calendar.addEvent({
                    id: data.id,
                    title: data.title,
                    start: data.start,
                    end: data.end,
                    editable: true
                });

                var taskModal = bootstrap.Modal.getInstance(document.getElementById('taskModal'));
                taskModal.hide();
                document.getElementById('taskForm').reset();
            })
            .catch(error => console.error('Error:', error));
        }
    });
});

    </script>
{% endblock %}
