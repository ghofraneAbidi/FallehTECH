{% extends 'front_base.html.twig' %}

{% block title %}Job Offers Calendar{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1 class="text-center">Worker Job Calendar</h1>
        <div id="calendar"></div>
    </div>

    <!-- ✅ Include FullCalendar via CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css">
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var calendarEl = document.getElementById('calendar');

            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                events: '/offre/emploi/travailleur/calendar', // Load worker's events
                eventClick: function(info) {
                    alert('Job: ' + info.event.title + '\nStart Date: ' + info.event.start.toISOString().split('T')[0]);
                }
            });

            calendar.render();
        });
    </script>
{% endblock %}
