<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Farm Challenge Game</title>
    <style>
        body {
            text-align: center;
            font-family: Arial, sans-serif;
        }
        .game-container {
            margin-top: 50px;
        }
        .hidden {
            display: none;
        }
    </style>
</head>
<body>
    <h2>🌾 Agriculture Challenge 🌾</h2>
    <p>Answer the question correctly and get **15% OFF** your entire panier!</p>

    <div class="game-container">
        <p><strong>Which crop is the most widely grown in the world?</strong></p>
        <button onclick="checkAnswer('A')">A) Rice</button>
        <button onclick="checkAnswer('B')">B) Wheat</button>
        <button onclick="checkAnswer('C')">C) Corn</button>
    </div>

    <div id="winMessage" class="hidden">
        <h3>🎉 Congratulations! You won 15% OFF your panier! 🎉</h3>
        <button onclick="redeemDiscount()">Apply Discount</button>
    </div>

    <script>
        function checkAnswer(answer) {
            if (answer === 'C') {
                document.querySelector('.game-container').classList.add('hidden');
                document.getElementById('winMessage').classList.remove('hidden');
            } else {
                alert('Wrong answer! Try again.');
            }
        }

        function redeemDiscount() {
            fetch('/apply-discount')
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('Discount applied to your panier!');
                        window.location.href = "/panier";
                    } else {
                        alert('You have already used your discount.');
                    }
                });
        }
    </script>

</body>
</html>
