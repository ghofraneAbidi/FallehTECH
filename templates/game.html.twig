{% extends 'front_base.html.twig' %}

{% block title %}Mini-Game{% endblock %}

{% block body %}
<section class="container text-center my-5">
    <h1>🎮 Play & Win 15% Discount! 🎮</h1>
    <p>Win this quick game to get a discount on your cart!</p>

    <canvas id="gameCanvas" width="400" height="400" style="border:1px solid black;"></canvas>
    
    <p id="winMessage" style="display:none; color:green; font-weight:bold;">
        🎉 Congrats! You won! Click below to claim your discount. 🎉
    </p>

    <button id="claimDiscountBtn" style="display:none;" class="btn btn-success">
    <a href="{{ path('game_win') }}" style="color: white; text-decoration: none;">
        Claim 15% Discount
    </a>
</button>


    <div id="touchControls" class="d-flex justify-content-center mt-3">
        <button class="btn btn-primary mx-2" id="upBtn">⬆️</button>
    </div>
    <div class="d-flex justify-content-center">
        <button class="btn btn-primary mx-2" id="leftBtn">⬅️</button>
        <button class="btn btn-primary mx-2" id="rightBtn">➡️</button>
    </div>
    <div class="d-flex justify-content-center">
        <button class="btn btn-primary mx-2" id="downBtn">⬇️</button>
    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function () {
    let canvas = document.getElementById("gameCanvas");
    let ctx = canvas.getContext("2d");
    let x = 200, y = 200, speed = 5;
    let goalX = Math.random() * 350, goalY = Math.random() * 350;
    let won = false;

    function draw() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        // Draw player (red circle)
        ctx.fillStyle = "red";
        ctx.beginPath();
        ctx.arc(x, y, 10, 0, Math.PI * 2);
        ctx.fill();

        // Draw goal (green circle)
        ctx.fillStyle = "green";
        ctx.beginPath();
        ctx.arc(goalX, goalY, 10, 0, Math.PI * 2);
        ctx.fill();

        // Check if player wins
        if (Math.abs(x - goalX) < 10 && Math.abs(y - goalY) < 10) {
            won = true;
            document.getElementById("winMessage").style.display = "block";
            document.getElementById("claimDiscountBtn").style.display = "block";
        }
    }

    function movePlayer(direction) {
        if (won) return;
        if (direction === "up") y -= speed;
        if (direction === "down") y += speed;
        if (direction === "left") x -= speed;
        if (direction === "right") x += speed;
        draw();
    }

    document.addEventListener("keydown", function(event) {
        if (event.key === "ArrowUp") movePlayer("up");
        if (event.key === "ArrowDown") movePlayer("down");
        if (event.key === "ArrowLeft") movePlayer("left");
        if (event.key === "ArrowRight") movePlayer("right");
    });

    document.getElementById("upBtn").addEventListener("click", () => movePlayer("up"));
    document.getElementById("downBtn").addEventListener("click", () => movePlayer("down"));
    document.getElementById("leftBtn").addEventListener("click", () => movePlayer("left"));
    document.getElementById("rightBtn").addEventListener("click", () => movePlayer("right"));

    draw();

    // Handle discount claim
 document.getElementById("claimDiscountBtn").addEventListener("click", function() {
    fetch('/apply-discount')
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                window.location.href = data.redirect; // Redirect directly to cart
            } else {
                alert(data.message); // Show error if discount already applied
            }
        })
        .catch(error => {
            console.error("Error applying discount:", error);
            alert("There was an issue applying the discount. Please try again.");
        });
});



});
</script>

{% endblock %}
