<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
	<!-- Boxicons -->
	<link href='https://unpkg.com/boxicons@2.0.9/css/boxicons.min.css' rel='stylesheet'>
	<!-- My CSS -->
	<link rel="stylesheet" href="{{asset('backoffice/style.css') }}">

		<link rel="stylesheet" href="{{ asset('sarahcss1/style.css') }}">
		<link rel="stylesheet" href="{{ asset('sarahcss1/styles.css') }}">

		<link
		href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
		<!-- Boxicons -->
		<link href="{{ asset('https://unpkg.com/boxicons@2.0.9/css/boxicons.min.css ') }}" rel="stylesheet">
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
		<link
		rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

		

	<title>Dashboard</title>
	<style>
		
	</style>
</head>
<body>

	<!-- SIDEBAR -->
	<section id="sidebar">
		<a href="#" class="brand">
				
			<span class="text"><img src="{{asset('backoffice/img/logo.png') }}" alt=""></span>
		</a>
		<ul class="side-menu top">
			<li>
				<a href="#">
					<i class='bx bxs-dashboard' ></i>
					<span class="text">Dashboard</span>
				</a>
			</li>
			<li class="active">
				<a href="{{ path('app_back_office') }}">
					<i class='bx bxs-group' ></i>
					<span class="text">Utilisateurs</span>
				</a>
			</li>
			{% if is_granted('ROLE_ADMIN') %}
						<li>
							<a href="{{ path('app_post_index') }}">
								<i class='bx bxs-group' ></i>
								<span class="text">Post Index</span>
							</a>
						</li>
			{% endif %}
			<li>
				<a href="#">
					<i class='bx bxs-group' ></i>
					<span class="text">Forum</span>
				</a>
			</li>
			</li>
			<li class="active">
				<a href="{{ path('app_produit_index') }}">
					<i class='bx bxs-group' ></i>
					<span class="text">les produits</span>
				</a>
			</li>
			<li>
				<a href="#">
					<i class='bx bxs-group' ></i>
					<span class="text">E-commerce</span>
				</a>
			</li>
			<li>
				<a href="#">
					<i class='bx bxs-group' ></i>
					<span class="text">Offres de Travail</span>
				</a>
			</li>
			<li>
				<a href="#">
					<i class='bx bxs-message-dots' ></i>
					<span class="text">Message</span>
				</a>
			</li>
			
		</ul>
		<ul class="side-menu">
			<li>
				<a href="#">
					<i class='bx bxs-cog' ></i>
					<span class="text">Settings</span>
				</a>
			</li>
			<li>
				<a href="{{ path('app_user_logout') }}" class="logout">
					<i class='bx bxs-log-out-circle' ></i>
					<span class="text">Déconnexion</span>
				</a>
			</li>
		</ul>
	</section>
	<!-- SIDEBAR -->

	<!-- CONTENT -->
	<section id="content">
		<!-- NAVBAR -->
		<nav>
			<i class='bx bx-menu' ></i>
			<a href="#" class="nav-link">Categories</a>
			<form action="#">
				<div class="form-input">
					<input type="search" placeholder="Search...">
					<button type="submit" class="search-btn"><i class='bx bx-search' ></i></button>
				</div>
			</form>
			<input type="checkbox" id="switch-mode" hidden>
			<label for="switch-mode" class="switch-mode"></label>
			<a href="#" class="notification">
				<i class='bx bxs-bell' ></i>
				<span class="num">8</span>
			</a>
			{% if app.user and app.user.name %}
				<h6> {{ app.user.name }} </h6>
			{% endif %}
			<a href="{{path('app_user_profile')}}" class="profile">
				<img src="{{asset('backoffice/img/avatar.jpg') }}" alt="Illustration">
			</a>
		</nav>
		<!-- NAVBAR -->

		<!-- MAIN -->
		<main>
			<div class="head-title">
				<div class="left">
					 
					<ul class="breadcrumb">
						<li>
							<a href="#">{% block title %}{% endblock %}</a>
						</li>
						<li><i class='bx bx-chevron-right' ></i></li>
						<li>
							<a class="active" href="#">Home</a>
						</li>
					</ul>
				</div>
				<a href="{{ path('app_user_new') }}" class="btn-download">
					<i class='bx bxs-cloud-download' ></i>
					<span class="text">Create New User</span>
				</a>
			</div>

			{% block body %}
			{% endblock %}

		
				<!-- Flash Messages -->
				{% for label, messages in app.flashes %}
					{% for message in messages %}
						<div class="alert alert-{{ label }}">
							{{ message }}
						</div>
					{% endfor %}
				{% endfor %}
				{% block content %}{% endblock %}
			
			</main>
		</section>
		<!-- CONTENT -->
		<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
		<!-- jQuery for Bootstrap JS -->
		<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
		<script src="{{ asset('JS/script.js') }}"></script>
		<script src="{{ asset('js/main.js') }}"></script>
	</body>
</html>
