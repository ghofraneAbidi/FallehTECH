{% form_theme form 'bootstrap_5_layout.html.twig' %}

<div class="container mt-5">
    <div class="card shadow-lg p-4">
        <h2 class="text-center mb-4">Modifier les informations</h2>
        {{ form_start(form) }}
        
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    {{ form_label(form.name) }}
                    {{ form_widget(form.name, {'attr': {'class': 'form-control'}}) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.last_name) }}
                    {{ form_widget(form.last_name, {'attr': {'class': 'form-control'}}) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.email) }}
                    {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.role) }}
                    {{ form_widget(form.role, {'attr': {'class': 'form-select', 'class': 'role-select'}}) }}
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    {{ form_label(form.carte_identite) }}
                    {{ form_widget(form.carte_identite, {'attr': {'class': 'form-control'}}) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.password) }}
                    {{ form_widget(form.password, {'attr': {'class': 'form-control'}}) }}
                </div>
                <div class="mb-3 worker-fields" style="display: none;">
                    {{ form_label(form.disponibility) }}
                    {{ form_widget(form.disponibility, {'attr': {'class': 'form-control'}}) }}
                </div>
                <div class="mb-3 worker-fields" style="display: none;">
                    {{ form_label(form.location) }}
                    {{ form_widget(form.location, {'attr': {'class': 'form-control'}}) }}
                </div>
                <div class="mb-3 worker-fields" style="display: none;">
                    {{ form_label(form.experience) }}
                    {{ form_widget(form.experience, {'attr': {'class': 'form-control'}}) }}
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between pt-3 px-5">
            <button type="submit" class="btn btn-primary">{{ button_label|default('Enregistrer') }}</button>
        </div>
        
        {{ form_end(form) }}
    </div>
</div>

<script>
   document.querySelector(".role-select").addEventListener("change", function() {
            const ouvrierFields = document.querySelectorAll(".worker-fields");
            if (this.value === "ouvrier") {
                ouvrierFields.forEach(field => field.style.display = "block");
            } else {
                ouvrierFields.forEach(field => field.style.display = "none");
            }
        });
</script>
