{% extends 'base_zied.html.twig' %}

{% block title %}Utilisateurs{% endblock %}

{% block body %}

<style>
    .container {
        max-width: 1200px;
        margin: auto;
    }

    h2 {
        color: #2d6a4f;
        font-weight: bold;
        text-align: center;
        margin-bottom: 30px;
    }

    .btn-toggle-stats, .btn-create {
        padding: 10px 15px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: bold;
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
    }

    .btn-toggle-stats {
        background: #66bb6a;
        color: #fff;
    }

    .btn-toggle-stats:hover {
        background: #388e3c;
        transform: translateY(-3px);
    }

    .btn-create {
        background: #007bff;
        color: #fff;
        margin-left: 20px;
    }

    .btn-create:hover {
        background: #0056b3;
        transform: translateY(-3px);
    }

    .button-container {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin: 20px 0;
    }

    /* Tableau des statistiques */
    #statsSection {
        max-width: 800px;
        margin: 40px auto;
        background: #ffffff;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0px 8px 16px rgba(0, 0, 0, 0.1);
    }

    #statsSection h3 {
        color: #388e3c;
        margin-bottom: 20px;
    }

    .stats-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

    .stats-table th, .stats-table td {
        padding: 12px 15px;
        text-align: center;
        border: 1px solid #e0e0e0;
    }

    .stats-table th {
        background-color: #66bb6a;
        color: white;
        font-weight: bold;
    }

    .stats-table tbody tr:nth-child(even) {
        background-color: #f5f5f5;
    }

    /* Style du tableau des posts */
    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

    table th, table td {
        padding: 12px 15px;
        text-align: center;
        border: 1px solid #e0e0e0;
    }

    table th {
        background-color: #66bb6a;
        color: white;
        font-weight: bold;
    }

    table tbody tr:nth-child(even) {
        background-color: #f5f5f5;
    }

    /* Style du champ de recherche */
    .searchInputBack {
        margin: 20px 0;
        width: 50%;
        padding: 10px;
        border: 2px solid #66bb6a;
        border-radius: 8px;
        font-size: 16px;
        outline: none;
        display: block;
        margin-left: auto;
        margin-right: auto;
    }

    .searchInputBack:focus {
        border-color: #388e3c;
    }
</style>

<div class="container mt-4">
    <div class="card shadow-lg p-4">
        <div class="card-header text-center">
            <h2>🌿 Gestion des Utilisateurs - BackOffice 📚</h2>
        </div>

        <div class="card-body">
            <!-- Boutons pour les actions -->
            <div class="button-container">
                <button id="toggleStatsButton" class="btn-toggle-stats" onclick="toggleStats()">Afficher Statistiques</button>
                <a href="{{ path('app_user_new') }}" class="btn-create">
                    <i class="fas fa-plus"></i> Créer un nouveau utilisateur
                </a>
            </div>

            <!-- Section des statistiques en tableau -->
            <div class="card shadow-lg p-3 mb-5 bg-white rounded" id="statsCard" style="display: none;">
                <div class="card-body text-center">
                    <h5 class="card-title mb-4">Statistiques des utilisateurs par rôle</h5>
                    <canvas id="roleChart" style="height: 200px; max-width: 60%; margin: 0 auto"></canvas>
                </div>
            </div>


            <!-- Search Bar and Role Filter -->
            <div class="row mb-4">
                
                <div class="col-md-6 offset-md-3">
                    <input type="text" id="searchInput" class="form-control searchInputBack" placeholder="Rechercher un utilisateur par nom...">
                </div>
                <div class="col-md-3">
                    <input type="text" hidden id="emailSearchInput" class="form-control" placeholder="Rechercher par email...">
                </div>
                <div class="col-md-3">
                    <select id="roleFilter" class="form-control">
                        <option value="">Filtrer par rôle</option>
                        <option value="client">Client</option>       
                        <option value="agriculteur">Agriculteur</option>
                        <option value="ouvrier">Ouvrier</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <select id="sortBy" class="form-select">
                        <option value="">Trier par</option>
                        <option value="prenomAsc">Prénom(A-Z)</option>
                        <option value="prenomDesc">Prénom(Z-A)</option>
                        <option value="nomAsc">Nom(A-Z)</option>
                        <option value="nomDesc">Nom(Z-A)</option>
                    </select>
                </div>
            </div>

            <!-- Tableau d'affichage des utilisateurs -->
            <table>
                <thead>
                    <tr>
                        <th style="cursor: pointer;" onclick="sortTable(0)">Nom</th>
                        <th style="cursor: pointer;" onclick="sortTable(1)">Prénom</th>
                        <th style="cursor: pointer;" onclick="sortTable(2)">Email</th>
                        <th style="cursor: pointer;" onclick="sortTable(3)">Rôle</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="usersList">
                    {% for user in users %}
                        {% if user.role != "ROLE_ADMIN" %}
                            <tr class="user-row" data-role="{{ user.role }}" data-name="{{ user.name }}" data-last-name ="{{ user.getLastName() }}" data-email="{{ user.email }}">
                                <td>{{ user.name }}</td>
                                <td>{{ user.getLastName() }}</td>
                                <td>{{ user.email }}</td>
                                <td>{{ user.role }}</td>
                                <td>
                                    <a href="{{ path('app_user_show', {'id': user.id}) }}" class="btn btn-success btn-sm">Consulter détails</a>
                                    <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-primary btn-sm">Modifier</a>
                                </td>
                            </tr>
                        {% endif %}
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center">Aucun utilisateur trouvé.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Chart.js and Chartjs-Plugin-Datalabels -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels"></script>

<script>
    document.getElementById('toggleStatsButton').addEventListener('click', function() {
        let statsCard = document.getElementById('statsCard');
        if (statsCard.style.display === 'none' || statsCard.style.display === '') {
            statsCard.style.display = 'block';
            this.textContent = 'Masquer les statistiques';
            initializeChart();
        } else {
            statsCard.style.display = 'none';
            this.textContent = 'Afficher les statistiques';
        }
    });

    function initializeChart() {
        var ctx = document.getElementById('roleChart').getContext('2d');
        new Chart(ctx, {
            type: 'pie',
            data: {
                labels: [
                    {% for role, count in usersByRole %}
                        '{{ role }}',
                    {% endfor %}
                ],
                datasets: [{
                    label: 'Nombre d\'utilisateurs',
                    data: [
                        {% for role, count in usersByRole %}
                            {{ count }},
                        {% endfor %}
                    ],
                    backgroundColor: [
                        'rgba(148, 87, 235, 0.8)',
                        'rgba(40, 167, 69, 0.8)',
                        'rgba(255, 193, 7, 0.8)',
                        'rgba(220, 53, 69, 0.8)'
                    ],
                    borderColor: [
                        'rgba(148, 87, 235, 1)',
                        'rgba(40, 167, 69, 1)',
                        'rgba(255, 193, 7, 1)',
                        'rgba(220, 53, 69, 1)'
                    ],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: { position: 'top' },
                    tooltip: { enabled: true },
                    datalabels: {
                        display: true,
                        color: 'white',
                        font: { weight: 'bold', size: 14 },
                        formatter: value => value
                    }
                }
            }
        });
    }

    function sortTable() {
       
        const tableBody = document.getElementById("usersList");

        const rowsArray = Array.from(document.querySelectorAll(".user-row"));
        const sortByValue = sortBy.value;

        rowsArray.sort((a, b) => {
        let valA,
        valB;

        if (sortByValue === "prenomAsc" || sortByValue === "prenomDesc") {
            valA = a.getAttribute("data-name");
            valB = b.getAttribute("data-name");
            return sortByValue === "prenomAsc" ? valA.localeCompare(valB) : valB.localeCompare(valA);
        } else if (sortByValue === "nomAsc" || sortByValue === "nomDesc") {
            valA = a.getAttribute("data-last-name").toLowerCase();
            valB = b.getAttribute("data-last-name").toLowerCase();
            return sortByValue === "nomAsc" ? valA.localeCompare(valB) : valB.localeCompare(valA);
        }

        return 0;
        });

        rowsArray.forEach(row => tableBody.appendChild(row));
    }

    function filterUsers() {
        const searchInput = document.getElementById('searchInput').value.toLowerCase();
        const emailSearchInput = document.getElementById('emailSearchInput').value.toLowerCase();
        const roleFilter = document.getElementById('roleFilter').value; // Ne pas convertir en lowercase

        const rows = document.querySelectorAll('.user-row');

        rows.forEach(row => {
            const name = row.getAttribute('data-name').toLowerCase();
            const lastName = row.getAttribute('data-last-name').toLowerCase();
            const email = row.getAttribute('data-email').toLowerCase();
            const role = row.getAttribute('data-role'); // Garde la casse d'origine

            const nameMatch = name.includes(searchInput);
            const lastNameMatch = lastName.includes(searchInput);
            const emailMatch = email.includes(emailSearchInput);
            const roleMatch = roleFilter === "" || role === roleFilter; // Comparaison exacte du rôle

            row.style.display = ((nameMatch || lastNameMatch) && emailMatch && roleMatch) ? '' : 'none';
        });
    }

    // Ajout des écouteurs d'événements
    document.getElementById('searchInput').addEventListener('input', filterUsers);
    document.getElementById('emailSearchInput').addEventListener('input', filterUsers);
    document.getElementById('roleFilter').addEventListener('change', filterUsers);
    const sortBy = document.getElementById("sortBy");
    sortBy.addEventListener("change", sortTable);


</script>

{% endblock %}
