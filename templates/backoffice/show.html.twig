{% extends 'backoffice/base.html.twig' %}


{% block body %}

<form method="post" action="{{ path('admin_user_toggle_active', {'id': user.id}) }}" class="text-end">
    <input type="hidden" name="_token" value="{{ csrf_token('toggle_active' ~ user.id) }}">
    {% if user.active %}
        <button type="submit" class="btn btn-danger m-3">Bloquer l'utilisateur</button>
    {% else %}
        <button type="submit" class="btn btn-success m-3">Activer l'utilisateur</button>
    {% endif %}
</form>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ user.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ user.name }}</td>
            </tr>
            <tr>
                <th>Last_name</th>
                <td>{{ user.lastName }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ user.email }}</td>
            </tr>
            <tr>
                <th>Password</th>
                <td>{{ user.password }}</td>
            </tr>
            <tr>
                <th>Role</th>
                <td>{{ user.role }}</td>
            </tr>
            <tr>
                <th>Carte_identite</th>
                <td>{{ user.carteIdentite }}</td>
            </tr>
            <tr>
                <th>Disponibility</th>
                <td>{{ user.disponibility ? user.disponibility|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Location</th>
                <td>{{ user.location }}</td>
            </tr>
            <tr>
                <th>Experience</th>
                <td>{{ user.experience }}</td>
            </tr>
        </tbody>
    </table>

    <div class="text-center">
        <a href="{{ path('app_back_office') }}" class="btn btn-success">Retour aux profils</a>
        <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-primary">Modifier profil</a>
    </div>

{% endblock %}
