{% extends 'dashboard.html.twig' %}

{% block title %}Livraison{% endblock %}

{% block body %}
    <h1>Livraison</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Num Commande </th>
                <td>{{ livraison.commande.id }}</td>
            </tr>
            <tr>
                <th>Num Livraison </th>
                <td>{{ livraison.id }}</td>
            </tr>
            <tr>
                <th>Statut</th>
                <td>{{ livraison.statut }}</td>
            </tr>
            <tr>
                <th>Transporteur</th>
                <td>{{ livraison.transporteur }}</td>
            </tr>
            <tr>
                <th>NumTelTransporteur</th>
                <td>{{ livraison.numTelTransporteur }}</td>
            </tr>
            <tr>
                <th>DateLivraison</th>
                <td>{{ livraison.dateLivraison ? livraison.dateLivraison|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_livraison_index') }}" title="Go Back" class="text-secondary mx-2">
        <i class="bi bi-arrow-left-circle fs-3"></i>
    </a>

    

{% endblock %}
