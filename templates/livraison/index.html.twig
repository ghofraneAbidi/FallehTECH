{% extends 'dashboard.html.twig' %}

{% block title %}Livraison index{% endblock %}

{% block body %}
    <h1>Liste des Livraisons</h1>

    
    <table class="table">
        <thead>
            <tr>
                <th>Num Livraison</th>
                <th>Statut</th>
                <th>Transporteur</th>
                <th>Numéro de Transporteur</th>
                <th>Date de Livraison</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for livraison in livraisons %}
            <tr>
                <td>{{ livraison.id }}</td>
                <td>{{ livraison.statut }}</td>
                <td>{{ livraison.transporteur }}</td>
                <td>{{ livraison.numTelTransporteur }}</td>
                <td>{{ livraison.dateLivraison ? livraison.dateLivraison|date('Y-m-d ') : '' }}</td>
                <td>
                    <!-- Show (Info) Icon -->
                    <a href="{{ path('app_livraison_show', {'id': livraison.id}) }}" title="View Details" class="text-primary mx-2">
                        <i class="bi bi-info-circle fs-5"></i>
                    </a>
                
                    <!-- Edit Icon -->
                    <a href="{{ path('app_livraison_edit', {'id': livraison.id}) }}" title="Edit Commande" class="text-warning mx-2">
                        <i class="bi bi-pencil-square fs-5"></i>
                    </a>

                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

  
{% endblock %}
