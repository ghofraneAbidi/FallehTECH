{{ form_start(form, {'attr': {'class': 'signup-form', 'novalidate': 'novalidate'}}) }}

    <div class="input-field">
        {{ form_widget(form.name, {'attr': {'placeholder': 'Nom'}}) }}
        <div style="color: red;">{{ form_errors(form.name) }}</div>
    </div>
    
    <div class="input-field">
        {{ form_widget(form.last_name, {'attr': {'placeholder': 'Prénom'}}) }}
        <div style="color: red;">{{ form_errors(form.last_name) }}</div>
    </div>
    
    <div class="input-field">
        {{ form_widget(form.email, {'attr': {'placeholder': 'Email', 'type': 'email'}}) }}
        <div style="color: red;">{{ form_errors(form.email) }}</div>
    </div>
    
    <div class="input-field">
        {{ form_widget(form.password, {'attr': {'placeholder': 'Mot de passe', 'type': 'password'}}) }}
        <div style="color: red;">{{ form_errors(form.password) }}</div>
    </div>
    
    <div class="input-field">
        {{ form_widget(form.phoneNumber, {'attr': {'placeholder': 'Numéro de téléphone (8 chiffres)'}}) }}
        <div style="color: red;">{{ form_errors(form.phoneNumber) }}</div>
    </div>
    
    <div class="input-field">
        {{ form_widget(form.carte_identite, {'attr': {'placeholder': 'Carte d\'identité'}}) }}
        <div style="color: red;">{{ form_errors(form.carte_identite) }}</div>
    </div>
    
    <div class="input-field">
        {{ form_widget(form.role, {'attr': {'class': 'role-select'}}) }}
        <div style="color: red;">{{ form_errors(form.role) }}</div>
    </div>

    <div class="input-field ouvrier-fields" style="display: none;">
        <label for="disponibility">Disponibilité</label>
        {{ form_widget(form.disponibility, {'attr': {'placeholder': 'Disponibilité'}}) }}
        <div style="color: red;">{{ form_errors(form.disponibility) }}</div>
    </div>
    
    <div class="input-field ouvrier-fields" style="display: none;">
        {{ form_widget(form.location, {'attr': {'placeholder': 'Lieu'}}) }}
        <div style="color: red;">{{ form_errors(form.location) }}</div>
    </div>
    
    <div class="input-field ouvrier-fields" style="display: none;">
        {{ form_widget(form.experience, {'attr': {'placeholder': 'Expérience'}}) }}
        <div style="color: red;">{{ form_errors(form.experience) }}</div>
    </div>

    <button type="submit" class="btn">{{ button_label|default('S\'inscrire') }}</button>
    
    <p class="signup-parag"> Vous avez déjà un compte ? <a href="{{ path('app_user_login') }}" class="signup-redirect">Se connecter</a></p>

{{ form_end(form) }}