{{ form_start(form) }}

<div class="form-group">
	{{ form_label(form.user) }}
	{{ form_widget(form.user, {'attr': {'class': 'form-control custom-dropdown', 'style': 'color: black;'}}) }}
	{% if form.user.vars.errors|length > 0 %}
		<div class="alert alert-danger mt-2">
			{% for error in form.user.vars.errors %}
				<p>{{ error.message }}</p>
			{% endfor %}
		</div>
	{% endif %}
</div>

<div class="form-group">
	{{ form_label(form.adresseLivraison) }}
	{{ form_widget(form.adresseLivraison, {'attr': {'class': 'form-control', 'style': 'color: black;'}}) }}
