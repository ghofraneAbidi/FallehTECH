		<div class="alert alert-danger mt-2">
			{% for error in form.adresseLivraison.vars.errors %}
				<p>{{ error.message }}</p>
			{% endfor %}
		</div>
	{% endif %}
</div>


<div class="form-group">
	{{ form_label(form.total) }}
	{{ form_widget(form.total, {'attr': {'class': 'form-control', 'id': 'total-field','style': 'color: black;'}}) }}
	{% if form.total.vars.errors|length > 0 %}
		<div class="alert alert-danger mt-2">
			{% for error in form.total.vars.errors %}
				<p>{{ error.message }}</p>
			{% endfor %}
		</div>
	{% endif %}
</div>

<div class="form-group">
	{{ form_label(form.ModePaiement) }}
	{{ form_widget(form.ModePaiement, {'attr': {'class': ' custom-dropdown','id': 'payment-method'}}) }}
	{% if form.ModePaiement.vars.errors|length > 0 %}
		<div class="alert alert-danger mt-2">
			{% for error in form.ModePaiement.vars.errors %}
				<p>{{ error.message }}</p>
			{% endfor %}
		</div>
	{% endif %}
</div>

{{ form_end(form) }}
