{% extends 'base.html.twig' %}

{% block title %}Commande index
{% endblock %}

{% block body %}
	<h1>Historiques des Commande
	</h1>

	<table class="table">
		<thead>
			<tr>
				<th>Id</th>
				<th>Date Creation</th>
				<th>Total</th>
				<th>statut</th>
				<th>Adresse Livraison</th>
				<th>Mode Paiement</th>
				<th>Date Paiement</th>
				<th>statut Paiement</th>
				<th>Actions</th>
			</tr>
		</thead>
		<tbody>
			{% for commande in commandes %}
				<tr>
					<td class="text-black">{{ commande.id }}</td>
					<td class="text-black">{{ commande.dateCreation ? commande.dateCreation|date('Y-m-d ') : '' }}</td>
					<td class="text-black">{{ commande.total }}</td>
					<td class="text-black">{{ commande.status }}</td>
					<td class="text-black">{{ commande.adresseLivraison }}</td>
					<td class="text-black">{{ commande.ModePaiement }}</td>
					<td class="text-black">{{ commande.datePaiement ? commande.datePaiement|date('Y-m-d ') : '' }}</td>
					<td class="text-black">{{ commande.statusPaiement }}</td>
					<td
						class="d-flex align-items-center">
						<!-- Show (Info) Icon -->
						<a href="{{ path('front_commande_show', {'id': commande.id}) }}" title="Voir les Détails" class="text-primary mx-2">
							<i class="bi bi-info-circle" style="font-size: 1.25rem;"></i>
						</a>

						{{ include('commande/_annuler_front.html.twig') }}
					</td>


				</tr>
			{% else %}
				<tr>
					<td colspan="9">no records found</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>


{% endblock %}
