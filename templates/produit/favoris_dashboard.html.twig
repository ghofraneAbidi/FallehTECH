{% extends 'base_zied.html.twig' %}
{% block body %}
   <style>
    
    /* Use the colors and fonts you provided */
:root {
    --primary-color: #9BAB10; /* Custom Green */
    --success-color: #CFE8FF; /* Light Blue */
    --text-color: #333; /* Darker Text */
    --background-color: #F9F9F9; /* Light Background */
    --border-color: #AAAAAA; /* Dark Grey */
    --hover-darken: rgba(0, 0, 0, 0.1);

    --font-primary: 'Poppins', sans-serif;
    --font-secondary: 'Lato', sans-serif;
}

/* Container to align buttons */
.buttons-container {
    display: flex;
    gap: 15px;
    justify-content: flex-start;
    margin-top: 20px;
}

/* Custom Button Base */
.custom-btn {
    display: inline-block;
    padding: 12px 24px;
    font-family: var(--font-primary);
    font-weight: 600;
    font-size: 16px;
    text-transform: uppercase;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.3s ease-in-out;
    text-align: center;
    border: 2px solid transparent;
}

/* Primary Button (Favorites List) */
.primary-btn {
    background-color: var(--primary-color);
    color: white;
    border-color: var(--primary-color);
}

.primary-btn:hover {
    background-color: white;
    color: var(--primary-color);
    border: 2px solid var(--primary-color);
    box-shadow: 0 4px 10px var(--hover-darken);
}

/* Success Button (Add Product) */
.success-btn {
    background-color: var(--success-color);
    color: #333;
    border-color: var(--success-color);
}

.success-btn:hover {
    background-color: white;
    color: var(--success-color);
    border: 2px solid var(--success-color);
    box-shadow: 0 4px 10px var(--hover-darken);
}
</style>
    <section id="content">
        <main>
            <div class="produit-table-container">
                <div class="table-data">
                    <div class="head">
                        <h3>wishlist pour chaque user ❤️</h3>
                    </div>
                     
                </div>
            </div>

            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>  <th>ID USER</th>
                            <th>Produit</th>
                            <th>Nom</th>
                            <th>Prix</th>
                            <th>Stock</th>
                          
                        </tr>
                    </thead>
                    <tbody>
                        {% for favoris in favorisList %}
                            <tr>
                             <td>
                                    1
                                </td>
                                <td>
                                    <img src="{{ asset('uploads/' ~ favoris.produit.image) }}" 
                                         alt="{{ favoris.produit.nom }}" 
                                         class="img-thumbnail" 
                                         style="width: 70px; height: 70px;">
                                </td>
                                <td>{{ favoris.produit.nom }}</td>
                                <td>{{ favoris.produit.prix }} €</td>
                                <td>{{ favoris.produit.stock }}</td>
                               
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5">Aucun produit en favoris.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
     <div class="head">
                     
                    </div>
                     <div class="buttons-container">
               <!-- Go Back Button with Arrow Icon -->
    <a href="{{ path('app_produit_index') }}" class="custom-btn primary-btn">
        <i class="fas  fa-arrow-left"></i> <!-- Back Icon -->
    </a>
            </div>
            <!-- Button to return to product list -->
           
        </main>
    </section>
{% endblock %}
