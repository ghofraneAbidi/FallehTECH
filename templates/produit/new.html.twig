{% extends 'base_zied.html.twig' %}
{% block title %}New Produit{% endblock %}

{% block body %}
    <style>
        /* General Styling */
        body {
            font-family: 'Lato', sans-serif;
            background-color: #f8f9fa;
            color: #343a40;
            padding: 20px;
        }

        /* Page Title */
        h1 {
            font-size: 2.5rem;
            color: #2d6a4f;
            text-align: center;
            margin-bottom: 20px;
            font-weight: bold;
        }

        /* Centered Form Container */
        .page-container {
            display: flex;
            justify-content: center; /* Centers horizontally */
            align-items: center; /* Centers vertically */
            min-height: 100vh; /* Full height */
        }

        /* Form Box */
        .form-container {
            background: #e3f2e1; /* Light green */
            padding: 40px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            border-radius: 10px;
            width: 60%; /* Increase width for larger form */
            max-width: 700px;
        }

        /* Form Inputs */
        input, select, textarea {
            padding: 12px;
            width: 100%;
            border-radius: 5px;
            border: 1px solid #ccc;
            margin-bottom: 15px;
            font-size: 1.1rem; /* Bigger text */
        }

        /* Labels */
        label {
            font-weight: bold;
            margin-bottom: 5px;
            display: block;
        }

        /* Submit Button */
        button {
            padding: 15px;
            background-color: #2d6a4f;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
            font-size: 1.2rem;
            width: 100%;
            transition: background-color 0.3s, transform 0.3s;
        }

        /* Button Hover */
        button:hover {
            background-color: #1f4d38;
            transform: scale(1.05);
        }

        /* Back Button */
        .back-btn {
            padding: 12px 15px;
            background-color: #2d6a4f;
            color: white;
            text-decoration: none;
            border-radius: 5px;
            font-weight: bold;
            display: inline-block;
            margin-top: 20px;
            text-align: center;
            transition: background-color 0.3s, transform 0.3s;
            width: 100%;
        }

        .back-btn:hover {
            background-color: #1f4d38;
            transform: scale(1.05);
        }
    </style>

    <h1>Create New Produit</h1>

    <div class="page-container">
        <div class="form-container">
    <!-- Start the Form -->
    {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}

    <!-- Nom Field -->
    <div>
        <label for="{{ form.nom.vars.id }}">Nom du Produit</label>
        {{ form_widget(form.nom, {'attr': {'class': 'form-control', 'placeholder': 'Entrez le nom du produit', 'required': 'required'}}) }}
        <small id="nomError" class="error-message"></small>
    </div>

    <!-- Prix Field -->
    <div>
        <label for="{{ form.prix.vars.id }}">Prix (DT)</label>
        {{ form_widget(form.prix, {'attr': {'class': 'form-control', 'placeholder': 'Entrez le prix en dinars', 'required': 'required'}}) }}
        <small id="prixError" class="error-message"></small>
    </div>

    <!-- Description Field -->
    <div>
        <label for="{{ form.description.vars.id }}">Description</label>
        {{ form_widget(form.description, {'attr': {'class': 'form-control', 'placeholder': 'Ajoutez une description du produit...', 'rows': 4, 'required': 'required'}}) }}
        <small id="descriptionError" class="error-message"></small>
    </div>

    <!-- Image Upload Field -->
    <div>
        <label for="{{ form.imageFile.vars.id }}">Upload Image</label>
        {{ form_widget(form.imageFile, {'attr': {'class': 'form-control'}}) }}
    </div>

    <!-- Category and Subcategory Fields -->
    <div>
        <label for="{{ form.categorie.vars.id }}">Catégorie</label>
        {{ form_widget(form.categorie, {'attr': {'class': 'form-control', 'id': 'produit_categorie'}}) }}
    </div>

    <div>
        <label for="{{ form.sousCategorie.vars.id }}">Sous-Catégorie</label>
        {{ form_widget(form.sousCategorie, {'attr': {'class': 'form-control', 'id': 'produit_sousCategorie'}}) }}
    </div>

    <!-- Stock Selection Field (✅ Now Added) -->
    <div>
        <label for="{{ form.stock.vars.id }}">Stock</label>
        {{ form_widget(form.stock, {'attr': {'class': 'form-control'}}) }}
    </div>

    <!-- Display Errors -->
    {{ form_errors(form) }}

    <!-- Action Buttons (✅ Save & Back to List are Side-by-Side) -->
    <div class="d-flex justify-content-between mt-3">
        <a href="{{ path('app_produit_index') }}" class="btn btn-secondary">⬅ Back to list</a>
        <button type="submit" class="btn btn-success">Save</button>
    </div>

    {{ form_end(form) }}
</div>

    </div>

    <script>
        // Listen for changes in the category dropdown
        document.getElementById('produit_categorie').addEventListener('change', function () {
            const categorieId = this.value;
            const sousCategorieSelect = document.getElementById('produit_sousCategorie');

            if (categorieId) {
                // Fetch the subcategories using AJAX
                fetch(`/produit/get-souscategories/${categorieId}`)
                    .then(response => response.json())
                    .then(data => {
                        sousCategorieSelect.innerHTML = '<option value="">Sélectionnez une sous-catégorie</option>';
                        
                        data.forEach(sousCategorie => {
                            const option = document.createElement('option');
                            option.value = sousCategorie.id;
                            option.textContent = sousCategorie.nom;
                            sousCategorieSelect.appendChild(option);
                        });
                    })
                    .catch(error => console.error('Erreur lors de la récupération des sous-catégories:', error));
            } else {
                sousCategorieSelect.innerHTML = '<option value="">Sélectionnez une sous-catégorie</option>';
            }
        });
      document.addEventListener("DOMContentLoaded", function () {
    // Get form elements
    const nomInput = document.getElementById("produit_nom");
    const prixInput = document.getElementById("produit_prix");
    const descriptionInput = document.getElementById("produit_description");
    const categorieInput = document.getElementById("produit_categorie");
    const sousCategorieInput = document.getElementById("produit_sousCategorie");
    
    const submitBtn = document.getElementById("submitBtn"); // ✅ Now correctly declared once

    // Get error display elements
    const nomError = document.getElementById("nomError");
    const prixError = document.getElementById("prixError");
    const descriptionError = document.getElementById("descriptionError");
    const categorieError = document.getElementById("categorieError");
    const sousCategorieError = document.getElementById("sousCategorieError");

    /**
     * ✅ Nom Validation (Only letters & spaces, min length: 3)
     */
    nomInput.addEventListener("input", function () {
        const nomValue = nomInput.value.trim();
        const regex = /^[A-Za-zÀ-ÖØ-öø-ÿ\s]+$/; // Accepts letters & spaces

        if (nomValue.length < 3) {
            nomError.textContent = "Le nom doit contenir au moins 3 caractères.";
            nomInput.style.borderColor = "red";
            submitBtn.disabled = true;
        } else if (!regex.test(nomValue)) {
            nomError.textContent = "Le nom ne doit contenir que des lettres et des espaces.";
            nomInput.style.borderColor = "red";
            submitBtn.disabled = true;
        } else {
            nomError.textContent = "";
            nomInput.style.borderColor = "green";
            checkFormValidity(); // ✅ Ensure form validity before enabling submit
        }
    });

    /**
     * ✅ Prix Validation (Only numbers, > 1 DT)
     */
    prixInput.addEventListener("input", function () {
        const prixValue = prixInput.value.trim();
        const prixNumber = parseFloat(prixValue);

        if (!/^\d+(\.\d{1,2})?$/.test(prixValue)) {
            prixError.textContent = "Entrez un nombre valide (ex: 10.50)";
            prixInput.style.borderColor = "red";
            submitBtn.disabled = true;
        } else if (prixNumber < 1) {
            prixError.textContent = "Le prix doit être supérieur à 1 DT.";
            prixInput.style.borderColor = "red";
            submitBtn.disabled = true;
        } else {
            prixError.textContent = "";
            prixInput.style.borderColor = "green";
            checkFormValidity();
        }
    });

    /**
     * ✅ Description Validation (Min 10, Max 500 characters)
     */
    descriptionInput.addEventListener("input", function () {
        const descriptionValue = descriptionInput.value.trim();

        if (descriptionValue.length < 10) {
            descriptionError.textContent = "La description doit contenir au moins 10 caractères.";
            descriptionInput.style.borderColor = "red";
            submitBtn.disabled = true;
        } else if (descriptionValue.length > 500) {
            descriptionError.textContent = "La description ne doit pas dépasser 500 caractères.";
            descriptionInput.style.borderColor = "red";
            submitBtn.disabled = true;
        } else {
            descriptionError.textContent = "";
            descriptionInput.style.borderColor = "green";
            checkFormValidity();
        }
    });

    /**
     * ✅ Category Validation (Must be selected)
     */
    categorieInput.addEventListener("change", function () {
        if (categorieInput.value === "") {
            categorieError.textContent = "Veuillez sélectionner une catégorie.";
            categorieInput.style.borderColor = "red";
            submitBtn.disabled = true;
        } else {
            categorieError.textContent = "";
            categorieInput.style.borderColor = "green";
            checkFormValidity();
        }
    });

    /**
     * ✅ Sub-Category Validation (Must be selected)
     */
    sousCategorieInput.addEventListener("change", function () {
        if (sousCategorieInput.value === "") {
            sousCategorieError.textContent = "Veuillez sélectionner une sous-catégorie.";
            sousCategorieInput.style.borderColor = "red";
            submitBtn.disabled = true;
        } else {
            sousCategorieError.textContent = "";
            sousCategorieInput.style.borderColor = "green";
            checkFormValidity();
        }
    });

    /**
     * ✅ Function to Enable Submit Button Only When Form is Valid
     */
    function checkFormValidity() {
        if (
            nomError.textContent === "" &&
            prixError.textContent === "" &&
            descriptionError.textContent === "" &&
            categorieError.textContent === "" &&
            sousCategorieError.textContent === ""
          
        ) {
            submitBtn.disabled = false;
        } else {
            submitBtn.disabled = true;
        }
    }
});

            
        
        
        
    </script>
{% endblock %}
