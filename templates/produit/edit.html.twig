{% extends 'base.html.twig' %}

{% block title %}Edit Produit{% endblock %}

{% block body %}
    <style>
        /* General styling for the form */
        .form-container {
            background-color: #d4f4d2;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            width: 80%;
            margin: 0 auto;
        }

        h1 {
            font-size: 2rem;
            color: #2d6a4f;
            text-align: center;
        }

        label {
            font-size: 1rem;
            color: #2d6a4f;
        }

        input, select, textarea {
            padding: 10px;
            width: 100%;
            border-radius: 5px;
            border: 1px solid #ccc;
            margin-bottom: 15px;
        }

        button {
            padding: 12px 20px;
            background-color: #2d6a4f;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
            font-size: 1rem;
            transition: background-color 0.3s, transform 0.3s;
        }

        button:hover {
            background-color: #1f4d38;
            transform: scale(1.05);
        }

        a.btn {
            padding: 12px 20px;
            background-color: #2d6a4f;
            color: white;
            text-decoration: none;
            border-radius: 5px;
            font-weight: bold;
            font-size: 1rem;
            transition: background-color 0.3s, transform 0.3s;
        }

        a.btn:hover {
            background-color: #1f4d38;
            transform: scale(1.05);
        }

        /* Error Messages */
        .error-message {
            color: red;
            font-size: 0.9rem;
        }
    </style>

    <h1>Edit Produit</h1>

    <div class="form-container">
        {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}

        <!-- Nom Field -->
        <div>
            <label for="{{ form.nom.vars.id }}">Nom du Produit</label>
            {{ form_widget(form.nom, {'attr': {'class': 'form-control', 'placeholder': 'Entrez le nom du produit'}}) }}
            <small id="nomError" class="error-message"></small>
        </div>

        <!-- Prix Field -->
        <div>
            <label for="{{ form.prix.vars.id }}">Prix (DT)</label>
            {{ form_widget(form.prix, {'attr': {'class': 'form-control', 'placeholder': 'Entrez le prix en dinars'}}) }}
            <small id="prixError" class="error-message"></small>
        </div>

        <!-- Description Field -->
        <div>
            <label for="{{ form.description.vars.id }}">Description</label>
            {{ form_widget(form.description, {'attr': {'class': 'form-control', 'placeholder': 'Ajoutez une description...', 'rows': 4}}) }}
            <small id="descriptionError" class="error-message"></small>
        </div>

        <!-- Image Field -->
        <div>
            <label for="{{ form.imageFile.vars.id }}">Image du Produit</label>
            {% if produit.image %}
                <img src="{{ asset('uploads/' ~ produit.image) }}" alt="Produit Image" style="max-width: 200px; margin-bottom: 10px;">
                <input type="text" class="form-control" value="{{ produit.image }}" readonly>
            {% endif %}
            {{ form_widget(form.imageFile, {'attr': {'class': 'form-control'}}) }}
            <small id="imageError" class="error-message"></small>
        </div>

        <!-- Category -->
        <div>
            <label for="{{ form.categorie.vars.id }}">Catégorie</label>
            {{ form_widget(form.categorie, {'attr': {'class': 'form-control', 'id': 'produit_categorie'}}) }}
            <small id="categorieError" class="error-message"></small>
        </div>

        <!-- Sub-Category -->
        <div>
            <label for="{{ form.sousCategorie.vars.id }}">Sous-Catégorie</label>
            {{ form_widget(form.sousCategorie, {'attr': {'class': 'form-control', 'id': 'produit_sousCategorie'}}) }}
            <small id="sousCategorieError" class="error-message"></small>
        </div>

        <!-- Stock Selection -->
        <div>
            <label for="{{ form.stock.vars.id }}">Stock</label>
            {{ form_widget(form.stock, {'attr': {'class': 'form-control'}}) }}
        </div>

        <!-- Submit & Back Buttons -->
        <div class="d-flex justify-content-between mt-3">
            <a href="{{ path('app_produit_index') }}" class="btn btn-secondary">⬅ Back to list</a>
            <button type="submit" id="submitBtn" class="btn btn-success">Update</button>
        </div>

        {{ form_end(form) }}
    </div>

    <!-- Delete Form Section -->
    {{ include('produit/_delete_form.html.twig') }}

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Fixing subcategory AJAX population
            const categorieSelect = document.getElementById('produit_categorie');
            const sousCategorieSelect = document.getElementById('produit_sousCategorie');

            if (categorieSelect) {
                categorieSelect.addEventListener('change', function () {
                    const categorieId = this.value;

                    if (categorieId) {
                        fetch(`/produit/get-souscategories/${categorieId}`)
                            .then(response => response.json())
                            .then(data => {
                                sousCategorieSelect.innerHTML = '<option value="">Sélectionnez une sous-catégorie</option>';
                                data.forEach(sousCategorie => {
                                    const option = document.createElement('option');
                                    option.value = sousCategorie.id;
                                    option.textContent = sousCategorie.nom;
                                    sousCategorieSelect.appendChild(option);
                                });
                            })
                            .catch(error => console.error('Erreur lors de la récupération des sous-catégories:', error));
                    } else {
                        sousCategorieSelect.innerHTML = '<option value="">Sélectionnez une sous-catégorie</option>';
                    }
                });
            }

            // Form validation
            function validateField(field, minLength, errorMessage) {
                if (field.value.trim().length < minLength) {
                    document.getElementById(errorMessage).textContent = `Doit contenir au moins ${minLength} caractères.`;
                    submitBtn.disabled = true;
                } else {
                    document.getElementById(errorMessage).textContent = "";
                    submitBtn.disabled = false;
                }
            }

            document.getElementById("{{ form.nom.vars.id }}").addEventListener("input", function () {
                validateField(this, 3, "nomError");
            });

            document.getElementById("{{ form.description.vars.id }}").addEventListener("input", function () {
                validateField(this, 10, "descriptionError");
            });

            document.getElementById("{{ form.prix.vars.id }}").addEventListener("input", function () {
                if (parseFloat(this.value.trim()) < 1) {
                    document.getElementById("prixError").textContent = "Le prix doit être supérieur à 1 DT.";
                    submitBtn.disabled = true;
                } else {
                    document.getElementById("prixError").textContent = "";
                    submitBtn.disabled = false;
                }
            });
        });
    </script>
{% endblock %}
