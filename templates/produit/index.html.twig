{% extends 'base.html.twig' %}

{% block body %}
<section id="content">
    <style>
        /* Pagination Styling */
        .pagination {
            display: flex;
            justify-content: center;
            margin-top: 20px;
            list-style: none;
            padding: 0;
            margin-left : 100px;
            margin-bottom : 10px;
        }

        .pagination li {
            margin: 0 5px;
        }

        .pagination a, .pagination span {
            display: inline-block;
            padding: 4px 8px;
            text-decoration: none;
            color: var(--primary-color);
            border: 1px solid var(--primary-color);
            border-radius: 5px;
            transition: background-color 0.3s ease;
        }

        .pagination a:hover {
            background-color: var(--primary-color);
            color: white;
        }

        .pagination .current {
            background-color: var(--primary-color);
            color: white;
            font-weight: bold;
        }

    /* Use the colors and fonts you provided */
:root {
    --primary-color: #9BAB10; /* Custom Green */
    --success-color: #CFE8FF; /* Light Blue */
    --text-color: #333; /* Darker Text */
    --background-color: #F9F9F9; /* Light Background */
    --border-color: #AAAAAA; /* Dark Grey */
    --hover-darken: rgba(0, 0, 0, 0.1);

    --font-primary: 'Poppins', sans-serif;
    --font-secondary: 'Lato', sans-serif;
}

/* Container to align buttons */
.buttons-container {
    display: flex;
    gap: 15px;
    justify-content: flex-start;
    margin-top: 20px;
}

/* Custom Button Base */
.custom-btn {
    display: inline-block;
    padding: 12px 24px;
    font-family: var(--font-primary);
    font-weight: 600;
    font-size: 16px;
    text-transform: uppercase;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.3s ease-in-out;
    text-align: center;
    border: 2px solid transparent;
}

/* Primary Button (Favorites List) */
.primary-btn {
    background-color: var(--primary-color);
    color: white;
    border-color: var(--primary-color);
}

.primary-btn:hover {
    background-color: white;
    color: var(--primary-color);
    border: 2px solid var(--primary-color);
    box-shadow: 0 4px 10px var(--hover-darken);
}

/* Success Button (Add Product) */
.success-btn {
    background-color: var(--success-color);
    color: #333;
    border-color: var(--success-color);
}

.success-btn:hover {
    background-color: white;
    color: var(--success-color);
    border: 2px solid var(--success-color);
    box-shadow: 0 4px 10px var(--hover-darken);
}
html, body {
    overflow-x: hidden; /* Désactive le scroll horizontal */
    overflow-y: auto; /* Active le scroll uniquement si nécessaire */
    height: 100%;
    margin: 0;
    padding: 0;
}

        
    </style>

    <main>
        <div class="produit-table-container">
            <div class="table-data">
                <div class="head">
                    <h3>Liste des Produits</h3>
                </div>
                <div class="buttons-container">
                    <a href="{{ path('favoris_dashboard') }}" class="custom-btn primary-btn">
                        <i class="fas fa-heart"></i> <!-- Heart Icon -->
                    </a>

                    <a href="{{ path('app_produit_new') }}" class="custom-btn success-btn">
                        <i class="fas fa-plus"></i> <!-- Plus Icon -->
                    </a>
                    <a href="{{ path('app_stats') }}" class="btn btn-primary">
    📊 Voir les Statistiques
</a>

                </div>
            </div>
        </div>

        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Nom</th>
                        <th>Prix</th>
                        <th>Description</th>
                        <th>Categorie</th>
                        <th>Souscategorie</th>
                        <th>Image</th>
                         <th>Stock</th> <!-- ✅ NEW COLUMN FOR STOCK -->
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for produit in produits %}
                        <tr>
                            <td>{{ produit.id }}</td>
                            <td>{{ produit.nom }}</td>
                            <td>{{ produit.prix }}</td>
                            <td>{{ produit.description }}</td>
                            <td>{{ produit.categorie.nom }}</td>
                            <td>{{ produit.sousCategorie.nom }}</td>
                            <td>
                                {% if produit.image %}
                                    <img src="{{ asset('uploads/' ~ produit.image) }}" 
                                         alt="{{ produit.nom }}" width="100" height="100">
                                {% else %}
                                    <p>No image</p>
                                {% endif %}
                            </td>
                        <td>
    <strong {% if produit.stock <= 5 %} style="color: red;" {% endif %}>
        {{ produit.stock }}
    </strong>
    <a href="{{ path('app_mail_alert', {'id': produit.id}) }}" title="Envoyer une alerte">
        <i class="fas fa-envelope" style="margin-left: 10px; color: #9BAB10; font-size: 18px;"></i>
    </a>
</td>



                            <td>
                                <a href="{{ path('app_produit_show', {'id': produit.id}) }}">Show</a>
                                <a href="{{ path('app_produit_edit', {'id': produit.id}) }}">Edit</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8">No products found.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        

        <!-- Pagination Links -->
        <nav>
            <ul class="pagination">
                {% if produits|length > 0 %}
                    {{ knp_pagination_render(produits) }}
                {% endif %}
            </ul>
        </nav>

    </main>
</section>
{% endblock %}
