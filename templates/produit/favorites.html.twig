{% extends 'base.html.twig' %}

{% block title %} Dashboard - Favoris {% endblock %}

{% block body %}
    <h1>Dashboard - Mes Favoris</h1>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>User ID</th>
                <th>Produit Favoris</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            {% for userId, favorisList in favoritesByUser %}
                <tr>
                    <td>{{ userId }}</td>
                    <td>
                        <ul>
                            {% for favorite in favorisList %}
                                <li>{{ favorite.produit.nom }} - {{ favorite.produit.prix }} €</li>
                            {% endfor %}
                        </ul>
                    </td>
                    <td>
                        <button class="btn btn-danger btn-sm">Retirer</button>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

{% endblock %}
