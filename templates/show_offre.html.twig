{% extends 'front_base.html.twig' %}

{% block title %}{{ offre.titre }} - Job Offer{% endblock %}

{% block body %}
    <div class="container">
        <h1 class="mb-4 text-primary">{{ offre.titre }}</h1>

        <div class="card shadow-sm">
            <div class="card-body">
                <h4 class="card-title text-dark">📌 Job Details</h4>
                <hr>
                <p><strong>📍 Location:</strong> {{ offre.lieu }}</p>
                <p><strong>📝 Description:</strong> {{ offre.description }}</p>
                <p><strong>💰 Salary:</strong> {{ offre.salaire ?? 'Not specified' }}</p>
                <p><strong>📅 Expiration Date:</strong> 
                    {{ offre.dateExpiration ? offre.dateExpiration|date('Y-m-d') : 'No expiration date' }}
                </p>
            </div>
        </div>

        <!-- Farmer (Employer) Details -->
        <div class="card mt-4 shadow-sm">
            <div class="card-body">
                <h4 class="card-title text-dark">👨‍🌾 Employer Details</h4>
                <hr>
                <p><strong>👤 Name:</strong> {{ offre.idEmployeur.nom }}</p>
                <p><strong>📧 Email:</strong> {{ offre.idEmployeur.email }}</p>
                <p><strong>📞 Contact:</strong> </p>
            </div>
        </div>

        <!-- Worker (Applicant) Details - Visible only if worker has applied -->
        {% if worker is defined and worker %}
            <div class="card mt-4 shadow-sm">
                <div class="card-body">
                    <h4 class="card-title text-dark">🧑‍🔧 Worker Details</h4>
                    <hr>
                    <p><strong>👤 Name:</strong> </p>
                    <p><strong>📧 Email:</strong> </p>
                    <p><strong>📞 Contact:</strong></p>
                </div>
            </div>
        {% endif %}

        <!-- Show Applications Button -->
        <div class="mt-4">
            <a href="{{ path('app_farmer_applications', {'id': offre.id}) }}" class="btn btn-dark">
                <i class="fas fa-users"></i> Show Applications
            </a>
        </div>

        <!-- Back Button -->
        <div class="mt-3">
            <a href="{{ path('app_offre_emploi_index') }}" class="btn btn-secondary">
                🔙 Back to Job Offers
            </a>
        </div>
    </div>
{% endblock %}
