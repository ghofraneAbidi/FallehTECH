{% extends 'front_base.html.twig' %}

{% block title %}Mon Panier{% endblock %}

{% block body %}
<section class="container my-5">
    <h1 class="text-center text-primary mb-4">
        <i class="fa fa-shopping-cart"></i> Mon Panier
    </h1>

    <!-- 🔙 Button to go back -->
    <button class="btn btn-secondary mb-3" onclick="history.back()">
        <i class="fa fa-arrow-left"></i> 
    </button>

    {% if cart is empty %}
        <p class="text-center text-muted">Votre panier est vide.</p>
    {% else %}
        <table class="table">
            <thead>
                <tr>
                    <th>Produit</th>
                    <th>Nom</th>
                    <th>Prix (DT)</th>
                    <th>Quantité</th>
                    <th>Total (DT)</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {% for item in cart %}
                <tr>
                    <td><img src="{{ asset('uploads/' ~ item.image) }}" style="width: 50px;"></td>
                    <td>{{ item.name }}</td>
                    <td>{{ item.price }}</td>
      <td>
    <button class="btn btn-sm btn-outline-secondary decreaseQty" data-id="{{ item.id }}">-</button>
    <span class="cart-qty" id="qty-{{ item.id }}">{{ item.quantity }}</span>
    <button class="btn btn-sm btn-outline-secondary increaseQty" data-id="{{ item.id }}">+</button>
</td>




                    <td>{{ (item.price * item.quantity)|number_format(2) }} DT</td>
                    <td>
                        <button class="btn btn-danger btn-sm remove-from-cart" data-id="{{ item.id }}">
                            <i class="fa fa-trash"></i> <!-- 🗑 Trash Icon -->
                        </button>

                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>


      
       {% set total_before_discount = 0 %}
{% set total = 0 %}

{% for item in cart %}
    {% set itemTotal = item.price * item.quantity %}
    {% set total_before_discount = total_before_discount + itemTotal %}
    {% set total = total + itemTotal %}
{% endfor %}

{% if discountApplied %}
    {% set total = total * 0.85 %}
    <p style="color: green; font-weight: bold;">🎉 15% de réduction appliquée ! 🎉</p>
    <p><strong>Ancien Prix :</strong> {{ total_before_discount|number_format(2) }} DT</p>
    <p><strong>Nouveau Prix :</strong> {{ total|number_format(2) }} DT</p>
{% else %}
   <p><strong>Total :</strong> <span id="cartTotal">{{ cart|reduce((carry, item) => carry + (item.price * item.quantity), 0)|number_format(2) }} DT</span></p>

{% endif %}


        <!-- Action Buttons -->
        <button class="btn btn-danger" id="clearCartBtn">
            <i class="fa fa-trash"></i> Vider le panier
        </button>
        <button class="btn btn-success" id="commander-button">
            <i class="fa fa-check"></i> Commander ✅
        </button>





    {% endif %}
</section>

<script>
document.addEventListener('DOMContentLoaded', function () {
    console.log("Page loaded, initializing functions...");

    // ✅ Check if the discount has been applied
    const urlParams = new URLSearchParams(window.location.search);
    if (!urlParams.has('discount_applied')) {
        console.log("Discount not applied yet. Waiting for QR Code scan...");
    }

    // ✅ Ensure QR Code scan applies discount correctly
    function applyDiscount() {
        console.log("Redirecting to apply discount...");
        window.location.href = "/apply-discount"; // Let Symfony handle discount logic
    }

  document.addEventListener("DOMContentLoaded", function () {
    console.log("✅ JavaScript Loaded: Event listeners will be attached!");

    function updateCartItem(id, action) {
        console.log(`🔄 Updating item ${id}, Action: ${action}`);

        let qtyElement = document.querySelector(`#qty-${id}`);
        if (!qtyElement) {
            console.error(`❌ Error: Cannot find #qty-${id}`);
            return;
        }

        let priceElement = qtyElement.closest("tr").querySelector("td:nth-child(3)");
        let totalElement = qtyElement.closest("tr").querySelector("td:nth-child(5)");

        if (!priceElement || !totalElement) {
            console.error(`❌ Error: Missing price/total for item ${id}`);
            return;
        }

        let price = parseFloat(priceElement.innerText);
        let currentQty = parseInt(qtyElement.innerText);

        if (action === "increase") {
            currentQty++;
        } else if (action === "decrease" && currentQty > 1) {
            currentQty--;
        } else {
            console.warn(`⚠️ Quantity cannot go below 1 for item ${id}`);
            return;
        }

        qtyElement.innerText = currentQty;
        let newTotal = (price * currentQty).toFixed(2);
        totalElement.innerText = `${newTotal} DT`;

        console.log(`✅ Item ${id} Updated: New Quantity = ${currentQty}, Total = ${newTotal} DT`);
        updateCartTotal();
    }

    function updateCartTotal() {
        let total = 0;
        document.querySelectorAll(".cart-qty").forEach(qtyElement => {
            let id = qtyElement.id.split("-")[1];
            let price = parseFloat(qtyElement.closest("tr").querySelector("td:nth-child(3)").innerText);
            let quantity = parseInt(qtyElement.innerText);
            total += price * quantity;
        });

        let cartTotalElement = document.getElementById("cartTotal");
        if (cartTotalElement) {
            cartTotalElement.innerText = `${total.toFixed(2)} DT`;
        }
        console.log(`🛒 Updated Cart Total: ${total.toFixed(2)} DT`);
    }

    document.querySelectorAll(".increaseQty").forEach(btn => {
        btn.addEventListener("click", function () {
            updateCartItem(this.dataset.id, "increase");
        });
    });

    document.querySelectorAll(".decreaseQty").forEach(btn => {
        btn.addEventListener("click", function () {
            updateCartItem(this.dataset.id, "decrease");
        });
    });

    console.log("✅ Event Listeners Attached Successfully!");
});


    // ✅ Remove Item from Cart
    document.querySelectorAll('.remove-from-cart').forEach(btn => {
        btn.addEventListener('click', function () {
            fetch(`/cart/remove/${this.dataset.id}`, { method: 'POST' })
                .then(() => location.reload());
        });
    });

    // ✅ Empty the Cart
    const clearCartBtn = document.getElementById('clearCartBtn');
    if (clearCartBtn) {
        clearCartBtn.addEventListener('click', function () {
            fetch('/cart/clear', { method: 'POST' })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('Le panier a été vidé.');
                        location.reload();
                    }
                })
                .catch(error => console.error('Erreur lors du vidage du panier:', error));
        });
    }

    // ✅ Checkout & Update Stock
    const commanderBtn = document.getElementById('commander-button');
    if (commanderBtn) {
        commanderBtn.addEventListener('click', function () {
            fetch('/cart/checkout', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('Commande validée ! Stock mis à jour.');
                    location.reload(); // Recharger la page pour afficher le nouveau stock
                } else {
                    alert('Erreur : ' + data.message);
                }
            })
            .catch(error => console.error('Erreur lors de la commande:', error));
        });
    }

});
document.addEventListener('DOMContentLoaded', function () {
    console.log("Page loaded, checking for discount...");

    // ✅ Detect if discount was applied
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('discount_applied')) {
        console.log("Discount applied! Reloading cart...");
        location.reload();
    }
});



</script>
{% endblock %}