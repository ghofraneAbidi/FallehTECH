{% extends 'front_base.html.twig' %}

{% block title %}Modifier Offre d'Emploi{% endblock %}

{% block body %}
    <div class="edit-form-container">
        <h1>Modifier l'Offre d'Emploi</h1>

        <div class="create-job-card">
            <div class="card-body">
                {{ form_start(form, {'attr': {'id': 'jobOfferForm', 'novalidate': 'novalidate'}}) }}

                <div class="mb-3">
                    {{ form_label(form.titre, 'Job Title') }}
                    {{ form_widget(form.titre, {'attr': {'class': 'form-control', 'id': 'titre'}}) }}
                    <small class="text-danger error-message" id="titreError"></small>
                </div>

                <div class="mb-3">
                    {{ form_label(form.description, 'Job Description') }}
                    {{ form_widget(form.description, {'attr': {'class': 'form-control', 'id': 'description'}}) }}
                    <small class="text-danger error-message" id="descriptionError"></small>
                </div>

                <div class="mb-3">
                    {{ form_label(form.lieu, 'Location') }}
                    {{ form_widget(form.lieu, {'attr': {'class': 'form-control', 'id': 'lieu'}}) }}
                    <small class="text-danger error-message" id="lieuError"></small>
                </div>

                <div class="mb-3">
                    {{ form_label(form.salaire, 'Salary (Optional)') }}
                    {{ form_widget(form.salaire, {'attr': {'class': 'form-control', 'id': 'salaire'}}) }}
                    <small class="text-danger error-message" id="salaireError"></small>
                </div>

                <div class="mb-3">
                    {{ form_label(form.startDate, 'Start Date') }}
                    {{ form_widget(form.startDate, {'attr': {'class': 'form-control', 'id': 'startDate'}}) }}
                    <small class="text-danger error-message" id="startDateError"></small>
                </div>

                <div class="mb-3">
                    {{ form_label(form.dateExpiration, 'Expiration Date') }}
                    {{ form_widget(form.dateExpiration, {'attr': {'class': 'form-control', 'id': 'dateExpiration'}}) }}
                    <small class="text-danger error-message" id="dateExpirationError"></small>
                </div>

                <button type="submit" class="btn btn-success" id="submitBtn">Mettre à Jour</button>
                <div id="formError" class="alert alert-danger mt-3 d-none"></div>

                {{ form_end(form) }}
            </div>
        </div>

        <div class="edit-button-group">
            <a href="{{ path('app_offre_emploi_index') }}" class="btn-back">Retour</a>
        </div>
    </div>

    <!-- JavaScript for AJAX Submission & Error Display -->
    <script>
      document.addEventListener("DOMContentLoaded", function () {
    const form = document.getElementById("jobOfferForm");

    form.addEventListener("submit", function (event) {
        event.preventDefault(); // ✅ Prevent normal form submission

        // ✅ Clear previous errors
        document.querySelectorAll(".error-message").forEach(el => el.textContent = "");
        const formError = document.getElementById("formError");
        if (formError) formError.classList.add("d-none");

        let formData = new FormData(form);

        fetch(form.action, {
            method: "POST",
            body: formData,
            headers: {
                "X-Requested-With": "XMLHttpRequest"
            }
        })
        .then(response => {
            if (!response.ok) {
                throw new Error(`Server error: ${response.status}`);
            }
            return response.text(); // ✅ Read response as text first
        })
        .then(text => {
            try {
                return JSON.parse(text); // ✅ Parse as JSON
            } catch (e) {
                throw new Error("Invalid JSON response from server. Received: " + text);
            }
        })
        .then(data => {
            if (data.status === "error") {
                // ✅ Show validation errors under each field
                for (let field in data.errors) {
                    let errorElement = document.getElementById(field + "Error");
                    if (errorElement) {
                        errorElement.textContent = data.errors[field];
                    }
                }

                // ✅ Show global error message
                if (data.globalError) {
                    formError.textContent = data.globalError;
                    formError.classList.remove("d-none");
                }
            } else {
                // ✅ Show success message and redirect
                alert("Job Offer Updated Successfully!");
                window.location.href = "{{ path('app_offre_emploi_index') }}"; // Redirect
            }
        })
        .catch(error => {
            console.error("Error:", error);
            alert("Error: " + error.message);
        });
    });
});

    </script>

{% endblock %}
