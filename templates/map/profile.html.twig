{% extends 'front_base.html.twig' %}

{% block title %}{{ land.name }} - Profile{% endblock %}

{% block body %}

    <div class="container mt-4">
        <h1 class="text-center">{{ land.name }}</h1>
       <p class="text-center"><strong>Owner:</strong> {{ land.owner.nom }}</p>
<p class="text-center"><strong>Owner:</strong> {{ land.description }}</p>
        <p class="text-center text-muted"><strong>Area:</strong> {{ land.area }} m²</p>

        <!-- Map Display -->
        <div id="map"></div>

        <!-- Job Offers -->
        <!-- Job Offers -->
<div class="card mt-4">
    <div class="card-body">
        <h3>Job Offers by {{ land.owner.nom }}</h3>
        {% if offers is not empty %}
            <ul class="list-group">
                {% for offer in offers %}
                    <li class="list-group-item">
                        <strong>{{ offer.titre }}</strong>: {{ offer.description }}
                        <span class="badge bg-success float-end">💰 {{ offer.salaire }} TND</span>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p>No job offers available.</p>
        {% endif %}
    </div>
</div>
<!-- Estimated Work & Cost Section -->
