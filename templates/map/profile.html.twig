    <div class="card-body">
        <h3>AI-Generated Work Estimation</h3>
        <p><strong>Work Description:</strong> {{ workDescription }}</p>
        <p><strong>Estimated Cost:</strong> 💰 {{ estimatedCost }}</p>
    </div>
</div> -->

<!-- Back to Map Button -->
<div class="mt-3">
    <a href="{{ path('worker_map') }}" class="btn btn-secondary">
        ⬅️ Back to Map
    </a>
</div>


    <!-- Leaflet & Styles -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />

    <!-- JavaScript Libraries -->
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

    <!-- Land Profile Map -->
    <script>
       var map = L.map('map').setView([{{ coordinates[0].latitude }}, {{ coordinates[0].longitude }}], 12);

        
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        var polygon = L.polygon([
           {% for coord in coordinates %}
    [{{ coord.latitude }}, {{ coord.longitude }}]{% if not loop.last %},{% endif %}
{% endfor %}

        ], { color: 'blue', fillColor: 'blue', fillOpacity: 0.5 }).addTo(map);
    </script>

{% endblock %}
