{% extends 'front_base.html.twig' %}



{% block body %}

<style>
    /* 🌿 Palette inspirée de l'agriculture */
    :root {
        --primary-green:rgb(200, 246, 201);
        --light-green:rgb(124, 169, 72);
        --soft-gray: #F4F4F4;
        --text-dark: #333;
        --border-gray: #CCC;
        --delete-red: #E74C3C;
        --orange-accent: #FF9800;
    }

    /* 🌟 Titre */
    h1 {
        color: var(--light-green);
        font-weight: bold;
    }

    /* 📦 Table Styles */
    .favorites-table {
        background-color: white;
        border-radius: 10px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        overflow: hidden;
    }

    .favorites-table thead {
        background-color: var(--light-green);
        color: white;
    }

    /* 📸 Images carrées */
    .favorites-table img {
        width: 70px;
        height: 70px;
        border-radius: 5px; /* Coins légèrement arrondis */
        object-fit: cover;
    }

    /* 🛠 Actions */
    .action-btn {
        border: none;
        background: none;
        font-size: 1.2rem;
        cursor: pointer;
        transition: 0.3s;
    }

    .action-btn:hover {
        transform: scale(1.1);
    }

    .delete-btn {
        color: var(--delete-red);
    }

    .cart-btn {
        color: var(--orange-accent);
    }

    /* ✅ Notifications */
    .notification {
        position: fixed;
        top: 20px;
        right: 20px;
        background: var(--light-green);
        color: white;
        padding: 12px 18px;
        border-radius: 5px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.2);
        display: none;
    }
  /* 🌿 Alignement et Style du Header */
.favorites-header {
    display: flex;
    align-items: center;
    gap: 15px;  /* Espace entre le bouton et le titre */
    margin-bottom: 20px;
}

/* 🔙 Style du bouton Retour */
.back-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 45px;
    height: 45px;
    background-color: #8BC34A; /* Vert doux */
    color: white;
    font-size: 20px;
    border-radius: 8px;
    transition: all 0.3s ease;
    box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
    border: none;
    text-decoration: none;
}

/* 🖱 Effet au survol */
.back-button:hover {
    background-color: white;
    color: #8BC34A;
    border: 2px solid #8BC34A;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
}

/* ❤️ Style du titre Mes Favoris */
.favorites-title {
    font-size: 30px;
    font-weight: bold;
    color:rgb(109, 138, 50); /* Vert naturel */
    display: flex;
    align-items: center;
    gap: 10px;
}

.favorites-title i {
    font-size: 30px;
}

/* 📱 Responsive */
@media (max-width: 768px) {
    .favorites-title {
        font-size: 24px;
    }

    .back-button {
        width: 40px;
        height: 40px;
        font-size: 18px;
    }
}
</style>

<div class="favorites-header">
    <!-- 🔙 Nouveau Bouton Retour aligné -->
    <a href="javascript:history.back()" class="back-button">
        <i class="fa fa-arrow-left"></i>
    </a>

    <h1 class="text-primary favorites-title">
        Wishlist
    </h1>
</div>

    {% if favorisList is empty %}
        <p class="text-center text-muted">Aucun produit en favoris.</p>
    {% else %}
        <table class="table table-hover favorites-table">
            <thead>
                <tr>
                    <th>Produit</th>
                    <th>Nom</th>
                    <th>Prix (DT)</th>
                    <th>Stock</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for favoris in favorisList %}
                <tr id="favoris-{{ favoris.produit.id }}">
                    <td>
                        <img src="{{ asset('uploads/' ~ favoris.produit.image) }}" alt="{{ favoris.produit.nom }}">
                    </td>
                    <td>{{ favoris.produit.nom }}</td>
                    <td>{{ favoris.produit.prix }}</td>
                    <td>{{ favoris.produit.stock }}</td>
                    <td>
                        <!-- 🛒 Ajouter au panier -->
                        <button class="action-btn cart-btn addToCart" data-id="{{ favoris.produit.id }}">
                            <i class="fa fa-shopping-cart"></i>
                        </button>

                        <!-- 🗑 Supprimer -->
                        <form action="{{ path('remove_from_favorites', {'id': favoris.produit.id}) }}" method="post" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('remove' ~ favoris.produit.id) }}">
                            <button type="submit" class="action-btn delete-btn">
                                <i class="fa fa-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</div>

<!-- ✅ Notification -->
<div id="fav-notification" class="notification"></div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    // ✅ Fonction pour afficher la notification
    function showNotification(message, color) {
        let notification = document.getElementById('fav-notification');
        notification.textContent = message;
        notification.style.background = color;
        notification.style.display = 'block';

        setTimeout(() => {
            notification.style.display = 'none';
        }, 2000);
    }

    // 🛒 Ajouter au panier depuis la liste des favoris
    document.querySelectorAll('.addToCart').forEach(button => {
        button.addEventListener('click', function () {
            const productId = this.dataset.id;

            fetch(`/cart/add/${productId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ quantity: 1 })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showNotification('✅ Produit ajouté au panier !', '#4CAF50');
                } else {
                    showNotification('⚠️ Erreur : ' + data.message, 'red');
                }
            })
            .catch(error => console.error('Erreur:', error));
        });
    });
});
</script>

{% endblock %}
