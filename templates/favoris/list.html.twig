<!-- favorites/list.html.twig -->
{% block body %}
    <h1>Mes Favoris</h1>
    <table class="table">
        <thead>
            <tr>
                <th>Produit Favoris</th>
                <th>Prix Unitaire</th>
                <th>État du stock</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody id="favorites-list">
            <!-- Dynamically populated rows -->
            {% for favoris in favorisList %}
                <tr>
                    <td><img src="{{ asset('img/' ~ favoris.image) }}" style="width: 50px; height: 50px;"></td>
                    <td>{{ favoris.name }}</td>
                    <td>{{ favoris.price }} €</td>
                    <td>{{ favoris.stock }}</td>
                    <td><button class="btn btn-danger btn-sm">Retirer</button></td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
