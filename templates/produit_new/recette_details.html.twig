{% extends 'front_base.html.twig' %}

{% block body %}
<section class="container my-5">
    <h1 class="text-center text-primary mb-4">{{ recipe.title }}</h1>

    <div class="text-center">
        <img src="{{ recipe.image }}" class="img-fluid mb-3" alt="{{ recipe.title }}">
    </div>

    <h3>Ingrédients :</h3>
    <ul>
        {% for ingredient in recipe.extendedIngredients %}
            <li>{{ ingredient.original }}</li>
        {% endfor %}
    </ul>

    <h3>Instructions :</h3>
    <p>{{ recipe.instructions | raw }}</p>

    <a href="{{ path('produits_recettes', {'name': recipe.title}) }}" class="btn btn-secondary">Retour aux Recettes</a>
</section>
{% endblock %}
