{% extends 'frontoffice/base.html.twig' %}

{% block body %}
<section class="container my-5">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('produits_front') }}">Accueil</a></li>
            <li class="breadcrumb-item active" aria-current="page">Nos Catégories</li>
        </ol>
    </nav>

    <h1 class="text-center text-primary mb-4">Nos Catégories</h1>

    <div class="row">
        {% for categorie in categories %}
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card shadow-sm border-0 text-center">
                    <!-- Afficher l'image de la catégorie -->
                    <img src="{{ categorie.image }}" class="card-img-top img-fluid" alt="{{ categorie.nom }}">
                    <div class="card-body">
                        <a href="{{ path('categorie_details', {'categorie': categorie.nom}) }}">
                           {{ categorie.nom }}
                        </a>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</section>
<style> /* 🌿 Styles généraux */
body {
    font-family: 'Poppins', sans-serif;
    background-color: #f5f5f2; /* Douce teinte beige pour l'ambiance agricole */
    color: #3a3a3a;
}

/* ✅ Centrer le titre et lui donner un style naturel */
h1 {
    font-size: 2.5rem;
    color: #2d6a4f; /* Vert foncé naturel */
    font-weight: bold;
    text-align: center;
    margin-bottom: 30px;
}

/* 🥖 Style du fil d'Ariane (breadcrumb) */
.breadcrumb {
    background-color: transparent;
    font-size: 1rem;
    font-weight: bold;
}

.breadcrumb-item a {
    color: #2d6a4f;
    text-decoration: none;
}

.breadcrumb-item a:hover {
    text-decoration: underline;
}

/* 📦 Cartes des catégories */
.card {
    border-radius: 12px;
    overflow: hidden;
    background: #ffffff;
    transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
}

.card:hover {
    transform: scale(1.03);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
}

/* 🖼️ Images des catégories */
.card img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-bottom: 4px solid #2d6a4f;
}

/* 📝 Contenu des cartes */
.card-body {
    padding: 15px;
    background-color: #f8f9fa;
}

/* 🔗 Lien du nom de la catégorie */
.card-body a {
    font-size: 1.3rem;
    font-weight: bold;
    color: #2d6a4f;
    text-decoration: none;
    transition: color 0.3s ease-in-out;
}

.card-body a:hover {
    color: #17532b;
    text-decoration: underline;
}

/* 🖥️ Responsivité */
@media (max-width: 768px) {
    h1 {
        font-size: 2rem;
    }

    .card img {
        height: 180px;
    }

    .card-body a {
        font-size: 1.2rem;
    }
    /* ✅ Style du lien pour sous-catégories */
.sous-categorie-link {
    font-size: 1.3rem;
    font-weight: bold;
    color: #2d6a4f; /* Vert naturel */
    text-decoration: none;
    transition: color 0.3s ease-in-out;
}

/* ✅ Effet au survol */
.sous-categorie-link:hover {
    color: #17532b; /* Vert plus foncé */
    text-decoration: underline;
}

}
</style>
{% endblock %}
