{% extends 'front_base.html.twig' %}

{% block body %}
    <div class="container">
        <h2 class="text-center mt-4 text-success">Recettes Avec {{ ingredient }}</h2>

        <div class="row">
            {% for recipe in recipes %}
                <div class="col-md-6">
                    <div class="card mb-4 shadow-sm">
                       {% if recipe.image is defined and recipe.image is not empty %}
    <img src="{{ recipe.image }}" class="card-img-top" alt="{{ recipe.title }}"
         onerror="this.onerror=null; this.src='/images/default.jpg';">
{% else %}
    <img src="/images/default.jpg" class="card-img-top" alt="Default Image">
{% endif %}

                        <div class="card-body">
                            <h3 class="card-title">{{ recipe.title }}</h3>
                            <h5 class="text-primary">Ingrédients :</h5>
                            <p>{{ recipe.ingredients | replace({'\n': '<br>'}) | raw }}</p>
                            <h5 class="text-success">Instructions :</h5>
                            <p>{{ recipe.instructions | replace({'\n': '<br>'}) | raw }}</p>
                        </div>
                    </div>
                </div>
            {% else %}
                <p class="text-danger">Aucune recette trouvée.</p>
            {% endfor %}
        </div>
    </div>
{% endblock %}
