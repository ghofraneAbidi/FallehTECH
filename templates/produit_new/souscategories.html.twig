{% extends 'front_base.html.twig' %}

{% block body %}
<section class="container my-5">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('produits_front') }}">Accueil</a></li>
            <li class="breadcrumb-item"><a href="{{ path('produits_front') }}">Nos Catégories</a></li>
            <li class="breadcrumb-item active" aria-current="page">Types de {{ categorie }}</li>
        </ol>
    </nav>

    <h1 class="text-center text-primary mb-4">Nos {{ categorie }}</h1>
    
    <div class="row">
        {% for sousCategorie in sousCategories %}
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card shadow-sm border-0">
                    <!-- Image -->
                    <img src="{{ sousCategorie.image }}" alt="{{ sousCategorie.nom }}" class="card-img-top" style="height: 200px; object-fit: cover;">
                    <!-- Card Body -->
                    <div class="card-body text-center">
    <h5 class="card-title">
        <a href="{{ path('produits_par_souscategorie', {sousCategorie: sousCategorie.nom}) }}" class="sous-categorie-link">
            {{ sousCategorie.nom }}
        </a>
    </h5>
</div>

                </div>
            </div>
        {% endfor %}
    </div>
</section>
<style>
/* 🌿 Styles généraux */
body {
    font-family: 'Poppins', sans-serif;
    background-color: #f5f5f2; /* Douce teinte beige pour l'ambiance agricole */
    color: #3a3a3a;
}

/* ✅ Centrer le titre et lui donner un style naturel */
h1 {
    font-size: 2.5rem;
    color: #2d6a4f; /* Vert foncé naturel */
    font-weight: bold;
    text-align: center;
    margin-bottom: 30px;
}

/* 🥖 Style du fil d'Ariane (breadcrumb) */
.breadcrumb {
    background-color: transparent;
    font-size: 1rem;
    font-weight: bold;
}

.breadcrumb-item a {
    color: #2d6a4f;
    text-decoration: none;
}

.breadcrumb-item a:hover {
    text-decoration: underline;
}

/* 📦 Cartes des catégories */
.card {
    border-radius: 12px;
    overflow: hidden;
    background: #ffffff;
    transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
}

.card:hover {
    transform: scale(1.03);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
}

/* 🖼️ Images des catégories */
.card img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-bottom: 4px solid #2d6a4f;
}

/* 📝 Contenu des cartes */
.card-body {
    padding: 15px;
    background-color: #f8f9fa;
}

/* 🔗 Lien du nom de la catégorie */
.card-body a {
    font-size: 1.3rem;
    font-weight: bold;
    color: #2d6a4f;
    text-decoration: none;
    transition: color 0.3s ease-in-out;
}

.card-body a:hover {
    color: #17532b;
    text-decoration: underline;
}

/* 🖥️ Responsivité */
@media (max-width: 768px) {
    h1 {
        font-size: 2rem;
    }

    .card img {
        height: 180px;
    }

    .card-body a {
        font-size: 1.2rem;
    }
    /* ✅ Style du lien pour sous-catégories */
.sous-categorie-link {
    font-size: 1.3rem;
    font-weight: bold;
    color: #2d6a4f; /* Vert naturel */
    text-decoration: none;
    transition: color 0.3s ease-in-out;
}

/* ✅ Effet au survol */
.sous-categorie-link:hover {
    color: #17532b; /* Vert plus foncé */
    text-decoration: underline;
}
/* ✅ Style des titres principaux (h1) */
h1 {
    font-size: 2rem; /* Taille équilibrée */
    font-weight: 600; /* Semi-bold pour un look élégant */
    color: #3a3a3a; /* Gris foncé doux pour un meilleur contraste */
    text-align: center;
    text-transform: capitalize; /* Plus naturel */
    letter-spacing: 1px;
    margin-bottom: 25px;
    font-family: 'Poppins', sans-serif;
    background: linear-gradient(to right, #4CAF50, #2E8B57); /* Dégradé vert chic */
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent; /* Effet de texte dégradé */
}

/* ✅ Style des sous-titres h2 */
h2 {
    font-size: 1.5rem;
    font-weight: 500;
    color: #4CAF50; /* Vert plus clair */
    text-align: center;
    margin-bottom: 20px;
}

/* ✅ Style des petits titres h3 */
h3 {
    font-size: 1.2rem;
    font-weight: 500;
    color: #2E8B57; /* Vert forêt */
    text-align: left;
    margin-bottom: 15px;
}


}
</style>
{% endblock %}
