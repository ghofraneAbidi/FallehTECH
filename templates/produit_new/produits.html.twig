{% extends 'base.html.twig' %}

{% block body %}
<section class="container my-5">
    <h1 class="text-center text-primary mb-4">Produits de la sous-catégorie : {{ sousCategorie }}</h1>
    <div class="row">
        {% for produit in produits %}
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card shadow-sm border-0">
                    <!-- Image -->
                    <img src="{{ produit.image }}" alt="{{ produit.nom }}" class="card-img-top" style="height: 200px; object-fit: cover;">
                    <!-- Card Body -->
                    <div class="card-body text-center">
                        <h5 class="card-title">{{ produit.nom }}</h5>
                        <p class="card-text">{{ produit.description }}</p>
                        <p class="text-success font-weight-bold">{{ produit.prix }} €</p>
                        <a href="#" class="btn btn-primary">Détails</a>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</section>
{% endblock %}
