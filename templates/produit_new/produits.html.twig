{% extends 'front_base.html.twig' %}



{% block body %}
<section class="container my-5">
    <!-- Breadcrumb Navigation -->
   <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="{{ path('produits_front') }}">Accueil</a>
        </li>

        <li class="breadcrumb-item">
            <a href="{{ path('categorie_details', {'categorie': sousCategorie.categorie.nom}) }}">
                {{ sousCategorie.categorie.nom }}
            </a>
        </li>

        <li class="breadcrumb-item active" aria-current="page">
            {{ sousCategorie.nom }}
        </li>
    </ol>
</nav>



    <h1 class="text-center text-primary mb-4"> Nos {{ sousCategorie.nom }}</h1>

    <div class="row">
        {% for produit in produits %}
        <div class="col-md-4 mb-4">
            <div class="card product-card" style="width: 18rem;" 
                 data-product-id="{{ produit.id }}" 
                 data-product-name="{{ produit.nom }}" 
                 data-product-image="{{ asset('uploads/' ~ produit.image) }}" 
                 data-product-price="{{ produit.prix }}" 
                 data-product-stock="{{ produit.stock }}" 
                 data-product-description="{{ produit.description }}">

                <!-- Heart Icon in Top-Right Corner -->
                <div class="heart-icon-container">
                    <i class="fa fa-heart heart-icon {% if produit.isFavorite %}favorite{% endif %}" data-product-id="{{ produit.id }}"></i>
                </div>

                <img src="{{ asset('uploads/' ~ produit.image) }}" alt="{{ produit.nom }}" class="card-img-top" style="height: 200px; object-fit: cover;">
                <div class="card-body">
                    <h5 class="card-title">{{ produit.nom }}</h5>
                    <p class="card-text">{{ produit.description }}</p>
                    <p><strong>Prix:</strong> {{ produit.prix }} €</p>
                    <button class="btn btn-primary btn-details" data-bs-toggle="modal" data-bs-target="#productModal">
                        Voir les détails
                    </button>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
</section>

<!-- Modal -->
<div class="modal fade" id="productModal" tabindex="-1" aria-labelledby="productModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="productModalLabel">Product Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <img id="productImage" src="" alt="Product Image" class="img-fluid" style="max-width: 100%; height: auto;">
                <h3 id="productName"></h3>
                <p id="productDescription"></p>
                <p><strong>Prix:</strong> <span id="productPrice"></span> Dt</p>
                <p><strong>Stock:</strong> <span id="productStock"></span></p>
            </div>
        </div>
    </div>
</div>

{% endblock %}
