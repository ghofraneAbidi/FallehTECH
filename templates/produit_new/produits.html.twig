{% extends 'front_base.html.twig' %}

{% block title %}Produits{% endblock %}

{% block body %}
<section class="container my-5">
    <h1 class="text-center text-primary mb-4">Nos {{ sousCategorie.nom }}</h1>

    <!-- ✅ Notification de succès pour le panier -->
    <div id="cartNotification" class="alert alert-success d-none position-fixed top-0 start-50 translate-middle-x mt-3 shadow-lg"
         style="z-index: 1050; width: 300px; text-align: center;">
        <i class="fa fa-check-circle"></i> Produit ajouté au panier !
    </div>

    <!-- ✅ Notification de succès pour les favoris -->
    <div id="favoritesNotification" class="alert alert-info d-none position-fixed top-0 start-50 translate-middle-x mt-3 shadow-lg"
         style="z-index: 1050; width: 300px; text-align: center;">
        <i class="fa fa-heart"></i> Produit ajouté aux favoris !
    </div>

    <div class="row">
        {% for produit in produits %}
        <div class="col-md-4 mb-4">
            <div class="card product-card" style="width: 18rem;"
                 data-product-id="{{ produit.id }}"
                 data-product-name="{{ produit.nom }}"
                 data-product-image="{{ asset('uploads/' ~ produit.image) }}"
                 data-product-price="{{ produit.prix }}"
                 data-product-stock="{{ produit.stock }}">

                <!-- ❤️ Heart Icon for Favorites -->
                <div class="heart-icon-container">
                    <i class="fa fa-heart heart-icon {% if produit.isFavorite %}favorite{% endif %}" data-product-id="{{ produit.id }}"></i>
                </div>

                <!-- Product Image -->
                <img src="{{ asset('uploads/' ~ produit.image) }}" alt="{{ produit.nom }}" class="card-img-top" style="height: 200px; object-fit: cover;">

                <div class="card-body">
                    <h5 class="card-title">{{ produit.nom }}</h5>
                    <p class="card-text">{{ produit.description }}</p>
                    <p><strong>Prix:</strong> {{ produit.prix }} DT</p>

                    <!-- Quantity Selection -->
                    <div class="input-group mb-2">
                        <button class="btn btn-outline-secondary decreaseQty" data-id="{{ produit.id }}">-</button>
                        <input type="text" class="form-control text-center product-quantity" id="quantity-{{ produit.id }}" value="1" readonly>
                        <button class="btn btn-outline-secondary increaseQty" data-id="{{ produit.id }}">+</button>
                    </div>

                    <!-- Add to Cart Button -->
                    <button class="btn btn-primary addToCartBtn" data-id="{{ produit.id }}">
                        Ajouter au panier
                    </button>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function () {
    function showNotification(type) {
        const notification = type === 'cart' ? document.getElementById('cartNotification') : document.getElementById('favoritesNotification');
        notification.classList.remove('d-none'); // Show the notification

        // Hide after 3 seconds
        setTimeout(() => {
            notification.classList.add('d-none');
        }, 3000);
    }

    function updateCartView() {
        fetch('/cart')
            .then(response => response.json())
            .then(data => {
                const cart = data.cart;
                const cartCounter = document.getElementById('cartCounter');
                let totalItems = 0;

                Object.values(cart).forEach(item => {
                    totalItems += item.quantity;
                });

                // Update cart counter
                cartCounter.textContent = totalItems;
            });
    }

    function updateFavoritesCount() {
        fetch('/favorites/count')  // Ensure this route exists in Symfony
            .then(response => response.json())
            .then(data => {
                const favoritesCount = document.getElementById('favorites-count');
                if (favoritesCount) {
                    favoritesCount.textContent = data.count; // Update UI with correct count
                }
            })
            .catch(error => console.error('Erreur mise à jour des favoris:', error));
    }

    // ✅ Handle Add to Cart Click
    document.querySelectorAll('.addToCartBtn').forEach(button => {
        button.addEventListener('click', function () {
            const productId = this.dataset.id;
            const quantity = parseInt(document.getElementById('quantity-' + productId).value);

            fetch(`/cart/add/${productId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ quantity })
            }).then(response => response.json())
              .then(data => {
                  if (data.success) {
                      showNotification('cart'); // ✅ Show notification
                      updateCartView(); // ✅ Update cart icon
                  }
              });
        });
    });

    // ✅ Handle Add to Favorites Click
    document.querySelectorAll('.heart-icon').forEach(icon => {
        icon.addEventListener('click', function () {
            const productId = this.dataset.productId;

            fetch(`/favoris/add/${productId}`, {  // Ensure the correct Symfony route exists
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ productId: productId, userId: 1 })  // Static user, make dynamic if needed
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showNotification('favorites');
                    this.classList.toggle('text-danger');  // Toggle heart color
                    updateFavoritesCount();
                } else {
                    alert(data.message || 'Erreur, veuillez réessayer');
                }
            })
            .catch(error => {
                console.error('Erreur:', error);
                alert('Une erreur est survenue. Veuillez réessayer.');
            });
        });
    });

    // ✅ Handle Quantity Increase
    document.querySelectorAll('.increaseQty').forEach(button => {
        button.addEventListener('click', function () {
            const productId = this.dataset.id;
            let quantityInput = document.getElementById('quantity-' + productId);
            quantityInput.value = parseInt(quantityInput.value) + 1;
        });
    });

    // ✅ Handle Quantity Decrease
    document.querySelectorAll('.decreaseQty').forEach(button => {
        button.addEventListener('click', function () {
            const productId = this.dataset.id;
            let quantityInput = document.getElementById('quantity-' + productId);
            if (parseInt(quantityInput.value) > 1) {
                quantityInput.value = parseInt(quantityInput.value) - 1;
            }
        });
    });

    updateCartView();
    updateFavoritesCount();
});
</script>
<style>/* ✅ Styles généraux */
body {
    font-family: 'Lato', sans-serif;
    background-color: #f5f5f0; /* Fond doux inspiré de la nature */
    color: #343a40;
}

/* ✅ Titre principal */
h1 {
    font-size: 2.5rem;
    font-weight: bold;
    color: #2d6a4f; /* Vert nature */
    text-align: center;
    margin-bottom: 30px;
}

/* ✅ Conteneur principal */
.container {
    max-width: 1200px;
    margin: auto;
}

/* ✅ Cartes des produits */
.product-card {
    border: none;
    border-radius: 10px;
    overflow: hidden;
    transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
    background: #fff;
}

/* Effet au survol */
.product-card:hover {
    transform: scale(1.03);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
}

/* ✅ Image produit */
.product-card img {
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    height: 200px;
    object-fit: cover;
}

/* ✅ Corps de la carte */
.product-card .card-body {
    padding: 15px;
    text-align: center;
}

/* ✅ Nom du produit */
.product-card .card-title {
    font-size: 1.2rem;
    font-weight: bold;
    color: #2d6a4f;
}

/* ✅ Texte de description */
.product-card .card-text {
    font-size: 0.95rem;
    color: #555;
}

/* ✅ Prix */
.product-card p strong {
    color: #17532b; /* Vert foncé */
}

/* ✅ Bouton Ajouter au panier */
.addToCartBtn {
    width: 100%;
    background-color: #2d6a4f;
    color: white;
    font-size: 1rem;
    font-weight: bold;
    padding: 10px;
    border-radius: 5px;
    transition: background-color 0.3s ease-in-out;
}

/* Effet au survol */
.addToCartBtn:hover {
    background-color: #1f4d38;
}

/* ✅ Sélection de la quantité */
.input-group {
    display: flex;
    justify-content: center;
    align-items: center;
}

.input-group button {
    background: #2d6a4f;
    color: white;
    border: none;
    padding: 5px 10px;
    border-radius: 5px;
    transition: background-color 0.3s ease-in-out;
}

.input-group button:hover {
    background: #17532b;
}

/* ✅ Icône des favoris */
.heart-icon {
    position: absolute;
    top: 10px;
    right: 15px;
    font-size: 1.5rem;
    color: #ccc;
    cursor: pointer;
    transition: color 0.3s ease-in-out;
}

/* Si favori activé */
.heart-icon.favorite {
    color: red;
}

/* ✅ Notifications */
.alert {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1050;
    width: 300px;
    text-align: center;
    padding: 15px;
    font-weight: bold;
}

/* ✅ Animation de notification */
@keyframes fadeOut {
    0% { opacity: 1; }
    100% { opacity: 0; display: none; }
}

.d-none {
    animation: fadeOut 3s forwards;
}
/* ✅ Style des titres principaux (h1) */
h1 {
    font-size: 2rem; /* Taille équilibrée */
    font-weight: 600; /* Semi-bold pour un look élégant */
    color: #3a3a3a; /* Gris foncé doux pour un meilleur contraste */
    text-align: center;
    text-transform: capitalize; /* Plus naturel */
    letter-spacing: 1px;
    margin-bottom: 25px;
    font-family: 'Poppins', sans-serif;
    background: linear-gradient(to right, #4CAF50, #2E8B57); /* Dégradé vert chic */
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent; /* Effet de texte dégradé */
}

/* ✅ Style des sous-titres h2 */
h2 {
    font-size: 1.5rem;
    font-weight: 500;
    color: #4CAF50; /* Vert plus clair */
    text-align: center;
    margin-bottom: 20px;
}

/* ✅ Style des petits titres h3 */
h3 {
    font-size: 1.2rem;
    font-weight: 500;
    color: #2E8B57; /* Vert forêt */
    text-align: left;
    margin-bottom: 15px;
}

/* ✅ Style des titres principaux (h1) */
h1 {
    font-size: 2.2rem; /* Ajusté pour plus de lisibilité */
    font-weight: 700; /* Un peu plus épais mais pas trop */
    color: #2E7D32; /* Un vert naturel et doux */
    text-align: center;
    text-transform: capitalize; /* Plus naturel et élégant */
    letter-spacing: 1px;
    margin-bottom: 20px;
    font-family: 'Poppins', sans-serif; /* Une police moderne et lisible */
}

/* ✅ Style des sous-titres h2 */
h2 {
    font-size: 1.8rem;
    font-weight: 600;
    color: #388E3C; /* Vert plus vif mais doux */
    text-align: center;
    margin-bottom: 15px;
}

/* ✅ Style des petits titres h3 */
h3 {
    font-size: 1.4rem;
    font-weight: 500;
    color: #4CAF50; /* Un vert clair */
    text-align: left;
    margin-bottom: 12px;
}

/* ✅ Ajout d'un effet de soulignement léger pour plus d'élégance */
h1::after, h2::after {
    content: "";
    display: block;
    width: 60px;
    height: 3px;
    background-color: #4CAF50;
    margin: 8px auto;
    border-radius: 5px;
}

/* ✅ Style pour les titres avec un effet subtil */
h1 span {
    background: linear-gradient(to right, #2E7D32, #81C784);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}


</style>
{% endblock %}
