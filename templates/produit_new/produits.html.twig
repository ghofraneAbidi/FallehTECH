{% extends 'front_base.html.twig' %}

{% block title %}Produits{% endblock %}

{% block body %}
<h1>Produits de la sous-catégorie: {{ sousCategorie.nom }}</h1>

<div class="row">
    {% for produit in produits %}
    <div class="col-md-4 mb-4">
        <div class="card" style="width: 18rem;" data-product-id="{{ produit.id }}" data-product-name="{{ produit.nom }}" data-product-image="{{ asset('img/' ~ produit.image) }}" data-product-price="{{ produit.prix }}">
            <img src="{{ asset('img/' ~ produit.image) }}" alt="{{ produit.nom }}" class="card-img-top" style="height: 200px; object-fit: cover;">
            <div class="card-body">
                <h5 class="card-title">{{ produit.nom }}</h5>
                <p class="card-text">{{ produit.description }}</p>
                <p><strong>Prix:</strong> {{ produit.prix }} €</p>

                <!-- "Voir les détails" button triggers the modal -->
                <button class="btn btn-primary btn-details" data-bs-toggle="modal" data-bs-target="#productModal">
                    Voir les détails
                </button>
            </div>

            <!-- Heart icon for adding to favorites (visible on hover) -->
             <div class="heart-icon" style="font-size: 1.5rem; cursor: pointer;">
        <i class="fa fa-heart"></i>
    </div>
        </div>
    </div>
    {% endfor %}
</div>

<!-- Modal for Product Details -->
<div class="modal fade" id="productModal" tabindex="-1" aria-labelledby="productModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header">
                <h5 class="modal-title" id="productModalLabel">Détails du Produit</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <!-- Modal Body -->
            <div class="modal-body">
                <h3 id="productName"></h3>
                <img id="productImage" class="card-img-top mb-3" alt="" style="max-width: 100%;">
                <p id="productDescription"></p>
                <p><strong>Prix:</strong> <span id="productPrice"></span> €</p>
            </div>
            <!-- Modal Footer -->
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                <button type="button" class="btn btn-primary">Ajouter au Panier</button>
            </div>
        </div>
    </div>
</div>


<!-- The modal or section to display favorites -->
<div id="favoritesSection" style="display:none;">
    <h3>Mes Produits Favoris</h3>
    <ul id="favorites-list">
        <!-- This will be populated dynamically -->
    </ul>
</div>

<!-- Favorites Modal -->
<div id="favoritesModal" class="modal fade" tabindex="-1" aria-labelledby="favoritesModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="favoritesModalLabel">Mes Favoris</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Produit Favoris</th>
                            <th>Prix Unitaire</th>
                            <th>État du stock</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="favorites-list">
                        <!-- Dynamically populated rows will appear here -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


<script src="{{ asset('js/favorites.js') }}"></script>
{% endblock %}
