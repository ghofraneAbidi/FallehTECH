{% form_theme form 'bootstrap_5_layout.html.twig' %}

<div class="container mt-5">
    <div class="card shadow-lg p-4">
        <h2 class="text-center mb-4">Modifier mes informations</h2>
        {{ form_start(form) }}
        
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    {{ form_label(form.name) }}
                    {{ form_widget(form.name, {'attr': {'class': 'form-control'}}) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.last_name) }}
                    {{ form_widget(form.last_name, {'attr': {'class': 'form-control'}}) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.email) }}
                    {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.role) }}
                    {{ form_widget(form.role, {'attr': {'class': 'form-select role-select'}}) }}
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    {{ form_label(form.carte_identite) }}
                    {{ form_widget(form.carte_identite, {'attr': {'class': 'form-control'}}) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.password) }}
                    {{ form_widget(form.password, {'attr': {'class': 'form-control'}}) }}
                    <small class="form-text text-muted">Laissez vide si vous ne souhaitez pas changer le mot de passe</small>
                </div>

                <div class="mb-3 ouvrier-fields" style="display: none;">
                    {{ form_label(form.disponibility) }}
                    {{ form_widget(form.disponibility, {'attr': {'class': 'form-control'}}) }}
                </div>
                <div class="mb-3 ouvrier-fields" style="display: none;">
                    {{ form_label(form.location) }}
                    {{ form_widget(form.location, {'attr': {'class': 'form-control'}}) }}
                </div>
                <div class="mb-3 ouvrier-fields" style="display: none;">
                    {{ form_label(form.experience) }}
                    {{ form_widget(form.experience, {'attr': {'class': 'form-control'}}) }}
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-around pt-3 px-5">
            <a href="{{ path('app_user_profilefront') }}" class="btn custom-btn-bg">Revenir au profil</a>
            <button type="submit" class="btn btn-primary">{{ button_label|default('Enregistrer') }}</button>   
        </div>

        {{ form_end(form) }}

        <div class="mx-auto">
            {{ include('frontoffice/_delete_form.html.twig') }}
        </div>
    </div>
</div>

<script>
    document.querySelector(".role-select").addEventListener("change", function() {
        const ouvrierFields = document.querySelectorAll(".ouvrier-fields");
        if (this.value === "ouvrier") {
            ouvrierFields.forEach(field => field.style.display = "block");
        } else {
            ouvrierFields.forEach(field => field.style.display = "none");
        }
    });
</script>