<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>{% block title %}FarmFresh - Organic Farm{% endblock %}</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="Organic Farming" name="keywords">
    <meta content="Farm website with job offers" name="description">

    <!-- ✅ Bootstrap & FontAwesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">

    <!-- ✅ Custom Styles -->
    <link href="{{ asset('sarahcss/bootstrap.min.css') }}" rel="stylesheet">
    <link href="{{ asset('sarahcss/style.css') }}" rel="stylesheet">
</head>

<body>

    <!-- ✅ NAVBAR START -->
   <!-- Navbar Start -->
<nav class="navbar navbar-expand-lg bg-primary navbar-dark shadow-sm py-3 px-3">
    <!-- Logo -->
    <a href="/" class="navbar-brand">
        <img src="{{ asset('frontoffice/img/logo.png') }}" alt="FarmFresh Logo" class="logo">
    </a>

    <!-- Mobile Menu Toggle Button -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
        <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Navbar Items -->
    <div class="collapse navbar-collapse justify-content-center" id="navbarCollapse">
        <div class="navbar-nav mx-auto py-0">
            <a href="{{ path('app_home_front')}}" class="nav-item nav-link active">Home</a>
            <a href="about.html" class="nav-item nav-link">About</a>
            <a href="{{ path('app_post_front') }}" class="nav-item nav-link">offre de travail</a>
            <a href="{{ path('app_post_front') }}" class="nav-item nav-link">Posts</a>
            <a href="{{ path('produits_front') }}" class="nav-item nav-link">Produits</a> <!-- ✅ Products Page -->
        </div>
    </div>

    <!-- Hide Favoris & Panier for Agricultors -->
{% if 'ROLE_AGRICULTEUR' not in app.user.roles %}
    <a href="{{ path('favoris_list') }}" class="icon-btn">
        <i class="fa fa-heart"></i>
    </a>
    <a href="{{ path('cart_view') }}" class="icon-btn">
        <i class="fa fa-shopping-cart"></i>
    </a>
{% endif %}

        <!-- ✅ USER PROFILE -->
        <div class="d-flex align-items-center ms-3">
            {% if app.user %}
                <h6 class="px-3 text-black">{{ app.user.name }} {{ app.user.getLastName() }} </h6>
                <a href="{{ path('app_user_profilefront') }}" class="me-2">
                    <img src="{{asset('assets-front/img/Profile.png') }}" alt="Illustration" style="width: 60px ; height: 60px; object-fit: cover; border-radius: 50%">
                </a>
                <a href="{{ path('app_user_logout') }}" class="btn btn-primary py-md-3 px-md-5 me-3 ">Logout</a>
                {% else %}
                <a href="{{ path('login') }}" class="btn btn-outline-light">Login</a>
            {% endif %}
        </div>

</nav>
<!-- Navbar End -->


       
    </nav>
    <!-- ✅ NAVBAR END -->

    <!-- ✅ MAIN CONTENT -->
    <main class="container my-5">
        {% block body %}{% endblock %}
    </main>

    <!-- ✅ NOTIFICATION BARS -->
    <div id="favoritesNotification" class="alert alert-info d-none position-fixed top-0 start-50 translate-middle-x mt-3 shadow-lg"
         style="z-index: 1050; width: 300px; text-align: center;">
        <i class="fa fa-check-circle"></i> Produit ajouté aux favoris !
    </div>

    <div id="cartNotification" class="alert alert-success d-none position-fixed top-0 start-50 translate-middle-x mt-3 shadow-lg"
         style="z-index: 1050; width: 300px; text-align: center;">
        <i class="fa fa-shopping-cart"></i> Produit ajouté au panier !
    </div>

    <!-- ✅ FOOTER START -->
    <div class="container-fluid bg-footer bg-primary text-white mt-5">
        <div class="container">
            <div class="row gx-5">
                <div class="col-lg-4 col-md-6">
                    <h4 class="text-white mb-4">Get In Touch</h4>
                    <p><i class="bi bi-geo-alt"></i> 123 Street, New York, USA</p>
                    <p><i class="bi bi-envelope"></i> info@example.com</p>
                    <p><i class="bi bi-telephone"></i> +012 345 67890</p>
                </div>

                <div class="col-lg-4 col-md-6">
                    <h4 class="text-white mb-4">Quick Links</h4>
                    <a class="text-white" href="#">Home</a>
                    <a class="text-white" href="#">About Us</a>
                    <a class="text-white" href="#">Our Services</a>
                    <a class="text-white" href="#">Contact</a>
                </div>

                <div class="col-lg-4 col-md-6">
                    <h4 class="text-white mb-4">Newsletter</h4>
                    <p>Subscribe to our newsletter for updates</p>
                    <form>
                        <div class="input-group">
                            <input type="text" class="form-control border-white p-3" placeholder="Your Email">
                            <button class="btn btn-primary">Sign Up</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <!-- ✅ FOOTER END -->

    <!-- ✅ JavaScript -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>
