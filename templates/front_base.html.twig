<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>{% block title %}FarmFresh - Organic Farm{% endblock %}</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="Organic Farming" name="keywords">
    <meta content="Farm website with job offers" name="description">

    <!-- Favicon -->
    <link href="{{ asset('img/favicon.ico') }}" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&family=Roboto:wght@500;700&display=swap" rel="stylesheet">

    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="{{ asset('lib/owlcarousel/assets/owl.carousel.min.css') }}" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="{{ asset('css1/bootstrap.min.css') }}" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="{{ asset('css1/style.css') }}" rel="stylesheet">
</head>

<body>

    <!-- ✅ NAVBAR START -->
    <nav class="navbar navbar-expand-lg bg-primary navbar-dark shadow-sm py-3 px-3">
        <a href="#" class="navbar-brand">
            <img src="{{ asset('img/logo.png') }}" alt="FarmFresh Logo" class="logo">
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse justify-content-center" id="navbarCollapse">
            <div class="navbar-nav mx-auto py-0">
                <a href="#" class="nav-item nav-link">Home</a>
                <a href="#" class="nav-item nav-link">About</a>
                <a href="#" class="nav-item nav-link">Service</a>
                <a href="#" class="nav-item nav-link">Product</a>
                <a href="#" class="nav-item nav-link">Job Offers</a>
                <a href="#" class="nav-item nav-link">Contact</a>
            </div>
        </div>

        <!-- ✅ Single Favorites Icon in Navbar -->
        <div class="favorites-icon" style="position: relative; margin-left: auto; cursor: pointer;">
            <a href="#" id="favorites-icon" class="nav-link" data-bs-toggle="modal" data-bs-target="#favoritesModal">
                <i class="fa fa-heart"></i> <span id="favorites-count">0</span> Favoris
            </a>
        </div>
    </nav>
    <!-- ✅ NAVBAR END -->

    <!-- Main Content Block -->
    <main class="container my-5">
        {% block body %}{% endblock %}
    </main>

    <!-- ✅ FAVORITES MODAL -->
    <div class="modal fade" id="favoritesModal" tabindex="-1" aria-labelledby="favoritesModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="favoritesModalLabel">Mes Favoris</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <ul id="favorites-list" class="list-group">
                        <!-- Favorite products will be dynamically populated here -->
                    </ul>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                </div>
            </div>
        </div>
    </div>
    <!-- ✅ FAVORITES MODAL END -->

    <!-- Footer Start -->
    <footer class="container-fluid bg-footer bg-primary text-white mt-5">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 pt-5 mb-5">
                    <h4 class="text-white mb-4">Get In Touch</h4>
                    <p><i class="bi bi-geo-alt"></i> 123 Street, New York, USA</p>
                    <p><i class="bi bi-envelope-open"></i> info@example.com</p>
                    <p><i class="bi bi-telephone"></i> +012 345 67890</p>
                    <div class="d-flex mt-4">
                        <a class="btn btn-secondary btn-square rounded-circle me-2" href="#"><i class="fab fa-twitter"></i></a>
                        <a class="btn btn-secondary btn-square rounded-circle me-2" href="#"><i class="fab fa-facebook-f"></i></a>
                        <a class="btn btn-secondary btn-square rounded-circle me-2" href="#"><i class="fab fa-linkedin-in"></i></a>
                        <a class="btn btn-secondary btn-square rounded-circle" href="#"><i class="fab fa-instagram"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </footer>
    <!-- Footer End -->

    <!-- JavaScript Libraries -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="{{ asset('lib/owlcarousel/owl.carousel.min.js') }}"></script>
    <script src="{{ asset('js/main.js') }}"></script>
    <script src="{{ asset('js/favorites.js') }}"></script> <!-- Make sure favorites.js is properly linked -->
</body>

</html>
