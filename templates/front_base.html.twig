<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>{% block title %}FarmFresh - Organic Farm{% endblock %}</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="Organic Farming" name="keywords">
    <meta content="Farm website with job offers" name="description">

    <!-- ✅ Bootstrap & FontAwesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">

    <!-- ✅ Custom Styles -->
    <link href="{{ asset('css1/bootstrap.min.css') }}" rel="stylesheet">
    <link href="{{ asset('css1/style.css') }}" rel="stylesheet">
</head>

<body>

    <!-- ✅ NAVBAR START -->
    <nav class="navbar navbar-expand-lg bg-primary navbar-dark shadow-sm py-3 px-3">
        <a href="#" class="navbar-brand">
            <img src="{{ asset('img/logo.png') }}" alt="FarmFresh Logo" class="logo">
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse justify-content-center" id="navbarCollapse">
            <div class="navbar-nav mx-auto py-0">
                <a href="#" class="nav-item nav-link">Home</a>
                <a href="#" class="nav-item nav-link">About</a>
                <a href="#" class="nav-item nav-link">Service</a>
                <a href="#" class="nav-item nav-link">Product</a>
                <a href="#" class="nav-item nav-link">Job Offers</a>
                <a href="#" class="nav-item nav-link">Contact</a>
            </div>
        </div>

        <!-- ✅ FAVORITES & CART COUNTERS -->
        <div class="d-flex">
            <!-- ❤️ Favorites Button -->
            <a href="{{ path('favoris_list') }}" class="icon-btn position-relative">
                <i class="fa fa-heart"></i>
           
            </a>

            <!-- 🛒 Cart Button -->
            <a href="{{ path('cart_view') }}" class="icon-btn position-relative ms-3">
                <i class="fa fa-shopping-cart"></i>
                
            </a>
        </div>
    </nav>
    <!-- ✅ NAVBAR END -->

    <!-- ✅ MAIN CONTENT -->
    <main class="container my-5">
        {% block body %}{% endblock %}
    </main>

    <!-- ✅ NOTIFICATION BARS -->
    <div id="favoritesNotification" class="alert alert-info d-none position-fixed top-0 start-50 translate-middle-x mt-3 shadow-lg"
         style="z-index: 1050; width: 300px; text-align: center;">
        <i class="fa fa-check-circle"></i> Produit ajouté aux favoris !
    </div>

    <div id="cartNotification" class="alert alert-success d-none position-fixed top-0 start-50 translate-middle-x mt-3 shadow-lg"
         style="z-index: 1050; width: 300px; text-align: center;">
        <i class="fa fa-shopping-cart"></i> Produit ajouté au panier !
    </div>

    <!-- ✅ JavaScript -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    
</body>
</html>
