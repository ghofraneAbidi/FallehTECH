<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Boxicons -->
    <link href="{{ asset('https://unpkg.com/boxicons@2.0.9/css/boxicons.min.css') }}" rel="stylesheet">

    <!-- CSS -->
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    <link rel="stylesheet" href="{{ asset('css/styles.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <title>{% block title %}Dashboard{% endblock %}</title>
</head>
<body>

    <!-- SIDEBAR -->
    <section id="sidebar">
        <a href="#" class="brand">
            <span class="text"><img src="{{ asset('img/logo.png') }}" alt="Logo"></span>
        </a>
        <ul class="side-menu top">
            <li class="active">
                <a href="#">
                    <i class="bx bxs-dashboard"></i>
                    <span class="text">Dashboard</span>
                </a>
            </li>
            <li>
                <a href="#">
                    <i class="bx bxs-group"></i>
                    <span class="text">Utilisateurs</span>
                </a>
            </li>
            <li>
                <a href="#">
                    <i class="bx bxs-group"></i>
                    <span class="text">Produits</span>
                </a>
            </li>
            <li>
                <a href="#">
                    <i class="bx bxs-group"></i>
                    <span class="text">Forum</span>
                </a>
            </li>
            <li>
                <a href="#">
                    <i class="bx bxs-group"></i>
                    <span class="text">E-commerce</span>
                </a>
            </li>
            <li>
                <a href="#">
                    <i class="bx bxs-group"></i>
                    <span class="text">Offres de Travail</span>
                </a>
            </li>
            <li>
                <a href="#">
                    <i class="bx bxs-message-dots"></i>
                    <span class="text">Message</span>
                </a>
            </li>
        </ul>
        <ul class="side-menu">
            <li>
                <a href="#">
                    <i class="bx bxs-cog"></i>
                    <span class="text">Settings</span>
                </a>
            </li>
            <li>
                <a href="" class="logout">
                    <i class="bx bxs-log-out-circle"></i>
                    <span class="text">Logout</span>
                </a>
            </li>
        </ul>
    </section>
    <!-- SIDEBAR -->

    <!-- CONTENT -->
    <section id="content">
       
       <nav>
            <i class="bx bx-menu"></i>
            <a href="#" class="nav-link">Categories</a>

            <form action="#">
                <div class="form-input">
                    <input type="search" placeholder="Search...">
                    <button type="submit" class="search-btn"><i class="bx bx-search"></i></button>
                </div>
            </form>

            <!-- New Dropdown for Navigating Entities -->
            <div class="dropdown">
                <button class="dropbtn"><i class="bx bx-grid-alt"></i> Entities</button>
                <div class="dropdown-content">
                    <a href="{{ path('app_all_offers') }}"><i class="bx bxs-briefcase"></i> Offres de Travail</a>
                    <a href="{{ path('app_candidature_index') }}"><i class="bx bxs-file"></i> Candidatures</a>
                </div>
            </div>

            <!-- Logout Button Next to Entities -->
            <a href="{{ path('app_switch_user_page') }}" class="btn btn-danger ms-3">
                <i class="bx bxs-log-out-circle"></i> Disconnect
            </a>

            <a href="#" class="notification">
                <i class="bx bxs-bell"></i>
                <span class="num">8</span>
            </a>
            <a href="#" class="profile">
                <img src="{{ asset('img/zied.jpg') }}">
            </a>
        </nav>

        <!-- MAIN CONTENT -->
        <main>
            {% block content %}{% endblock %}
            {% block body %}{% endblock %}
        </main>
    </section>
    <!-- CONTENT -->

    <script src="{{ asset('JS/script.js') }}"></script>
</body>
</html>
