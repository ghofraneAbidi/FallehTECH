{% extends 'base.html.twig' %}

{% block title %}Se Connecter{% endblock %}

{% block body %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
{% if error %}
    <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
{% endif %}

<!-- Login Form -->
<div class="signup-container">
    <h2 style="text-align: center; color: #333;"> Connectez-vous </h2>
    <form action="{{ path('app_user_login') }}" method="post">
        <div class="input-field">
            <input type="email" id="email" name="_email" placeholder="Email" value="{{ last_email }}" required>
        </div>
        <div class="input-field">
            <input type="password" id="password" name="_password" placeholder="Mot de passe" required>
        </div>
        <button type="submit" class="btn">Se connecter</button>
        <a href="{{ path('app_login_google') }}" class="btn btn-google">
                <i class="fab fa-google"></i> Sign in with Google   
            </a>
        <p class="signup-parag">Vous n'avez pas un compte ? <a href="{{ path('app_user_signup')}}" class="signup-redirect">  Inscrivez-vous ! </a></p>
        <p><a href="{{ path('app_forgot_password') }}" class="text-danger">Mot de passe oublié ?</a></p>
    </form>
</div>

<script src="https://www.google.com/recaptcha/api.js" async defer></script>
<style>
     .btn-google {
        display: inline-block;
        width: 100%;
        padding: 0.75rem;
        background-color: #db4437;
        color: #fff;
        border: none;
        border-radius: 5px;
        font-size: 1rem;
        cursor: pointer;
        transition: background-color 0.3s ease, transform 0.3s ease;
        margin-top: 1rem;
    }

    .btn-google:hover {
        background-color: #c23321;
        transform: translateY(-2px);
    }

    .btn-google i {
        margin-right: 0.5rem;
    }
</style>
{% endblock %}