{% extends 'base.html.twig' %}

{% block title %}Détails de la Candidature{% endblock %}

{% block body %}
    <div class="candidature-container">
        <h1>Candidature #{{ candidature.id }}</h1>

        <table class="candidature-details">
            <tbody>
                <tr>
                    <th>Statut</th>
                    <td>{{ candidature.statut.value }}</td>
                </tr>
                <tr>
                    <th>Date Applied</th>
                    <td>{{ candidature.dateApplied ? candidature.dateApplied|date('Y-m-d H:i:s') : 'N/A' }}</td>
                </tr>
                <tr>
                    <th>Rating</th>
                    <td>{{ candidature.rating ?? 'Non noté' }}</td>
                </tr>
            </tbody>
        </table>

        <div class="candidature-actions">
            <a href="{{ path('app_candidature_index') }}" class="back-btn">Retour à la liste</a>
            <a href="{{ path('app_candidature_edit', {'id': candidature.id}) }}" class="edit-btn">Modifier</a>
            {{ include('candidature/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
