{% extends 'base_zied.html.twig' %}

{% block title %}Candidature index{% endblock %}

{% block body %}
    <div class="container">
        <h1>Candidatures</h1>

        <table class="table candidature-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Offre</th> {# Job Offer #}
                    <th>Travailleur</th> {# Worker Name Column #}
                    <th>Statut</th>
                    <th>Date Applied</th>
                    <th>Rating</th>
                    <th>Show</th>
                    <th>Edit</th>
                    <th>Delete</th>
                </tr>
            </thead>
            <tbody>
            {% for candidature in candidatures %}
                <tr>
                    <td>{{ candidature.id }}</td>
                    <td>{{ candidature.idOffre.titre }}</td>
                    <td>
                        {{ candidature.idTravailleur ? candidature.idTravailleur.name : 'Unknown' }}
                    </td>
                    <td>{{ candidature.statut.value }}</td>
                    <td>{{ candidature.dateApplied ? candidature.dateApplied|date('Y-m-d H:i:s') : 'N/A' }}</td>
                    <td>{{ candidature.rating ?? 'Non noté' }}</td>
                    <td>
                        <a href="{{ path('app_candidature_show', {'id': candidature.id}) }}" class="icon-link">
                            <i class="fas fa-eye"></i>
                        </a>
                    </td>
                    <td>
                        <a href="{{ path('app_candidature_edit', {'id': candidature.id}) }}" class="icon-link">
                            <i class="fas fa-edit"></i>
                        </a>
                    </td>
                    <td>
                        <form method="post" action="{{ path('app_candidature_delete', {'id': candidature.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ candidature.id) }}">
                            <button type="submit" class="delete-button">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="9" class="text-center">No records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {# Pagination Controls #}
        <div class="pagination">
            {% if candidatures|length > 0 %}
                {{ knp_pagination_render(candidatures) }}
            {% endif %}
        </div>

        <a href="{{ path('app_candidature_new') }}" class="create-button">
            <i class="fas fa-plus"></i> Create New
        </a>
    </div>

    <style>
        /* Delete button styling */
        .delete-button {
            background: none;
            border: none;
            color: black;
            cursor: pointer;
            font-size: 18px;
        }

        .delete-button:hover {
            color: gray;
        }

        /* Pagination Styling */
        .pagination {
            margin-top: 20px;
            text-align: center;
        }

        .pagination a, .pagination span {
            margin: 0 5px;
            padding: 8px 12px;
            text-decoration: none;
            border: 1px solid #ddd;
            color: black;
        }

        .pagination .current {
            font-weight: bold;
            background-color: #ddd;
        }
    </style>
{% endblock %}
