{% extends 'base.html.twig' %}

{% block title %}Candidature index{% endblock %}

{% block body %}
    <div class="container">
        <h1>Candidatures</h1>

        <table class="table candidature-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Statut</th>
                    <th>Date Applied</th>
                    <th>Rating</th>
                    <th>Show</th>
                    <th>Edit</th>
                    <th>Delete</th>
                </tr>
            </thead>
            <tbody>
            {% for candidature in candidatures %}
                <tr>
                    <td>{{ candidature.id }}</td>
                    <td>{{ candidature.statut.value }}</td>
                    <td>{{ candidature.dateApplied ? candidature.dateApplied|date('Y-m-d H:i:s') : 'N/A' }}</td>
                    <td>{{ candidature.rating ?? 'Non noté' }}</td>
                    <td>
                        <a href="{{ path('app_candidature_show', {'id': candidature.id}) }}" class="icon-link">
                            <i class="fas fa-eye"></i>
                        </a>
                    </td>
                    <td>
                        <a href="{{ path('app_candidature_edit', {'id': candidature.id}) }}" class="icon-link">
                            <i class="fas fa-edit"></i>
                        </a>
                    </td>
                    <td>
                        {{ include('candidature/_delete_form.html.twig', {'candidature': candidature}) }}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7" class="text-center">No records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <a href="{{ path('app_candidature_new') }}" class="create-button">
            <i class="fas fa-plus"></i> Create New
        </a>
    </div>
{% endblock %}
