{% extends 'base.html.twig' %}

{% block title %}Créer une Nouvelle Candidature{% endblock %}

{% block body %}
    <div class="container">
        <h1>Créer une Nouvelle Candidature</h1>

        {{ form_start(form) }}
            {{ form_widget(form) }}
            <button class="btn btn-success">Créer</button>
        {{ form_end(form) }}

        <a href="{{ path('app_candidature_index') }}" class="btn btn-secondary mt-3">Retour à la liste</a>
    </div>
{% endblock %}
