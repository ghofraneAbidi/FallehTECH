{% extends 'base.html.twig' %}

{% block title %}Statistiques{% endblock %}

{% block body %}
<style>
/* 🌍 Conteneur principal centré */
.stats-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    padding: 20px;
}

/* 🏷️ Titre Centré */
.stats-title {
    font-size: 2.5rem;
    font-weight: bold;
    color: #2d6a4f;
    text-align: center;
    margin-bottom: 20px;
    width: 100%;
}

/* 🔽 Sélecteurs Centrés */
.stats-select-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    margin-bottom: 20px;
}

.stats-select-container label {
    font-size: 1.2rem;
    font-weight: bold;
    margin-bottom: 5px;
}

#chartType, #productSelect {
    padding: 10px;
    font-size: 16px;
    border-radius: 5px;
    border: 1px solid #ccc;
    width: 250px;
    text-align: center;
}

/* 📊 Conteneur du Graphique */
.chart-container {
    width: 80%;
    max-width: 600px;
    margin: auto;
    padding: 20px;
}

canvas#statsChart, canvas#stockChart {
    max-width: 100%;
    height: 300px !important;
}

/* 📋 Tableau Centré */
#statsTable {
    width: 80%;
    max-width: 600px;
    margin: auto;
    border-collapse: collapse;
    background: #fff;
    text-align: center;
}

#statsTable th, #statsTable td {
    padding: 10px;
    text-align: center;
    border: 1px solid #ddd;
}

#statsTable th {
    background: #4CAF50;
    color: white;
}

/* 📉 Section Évolution du Stock */
.stock-evolution-container {
    width: 80%;
    max-width: 600px;
    margin: 30px auto;
    background: #e3f2e1;
    padding: 20px;
    border-radius: 10px;
    text-align: center;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
}

.stock-evolution-container h2 {
    font-size: 2rem;
    color: #2d6a4f;
}

/* ⚠️ Produits en Stock Faible */

.low-stock-container {
    background-color: #fff3cd;
    border-left: 5px solid #ff9800;
    padding: 20px;
    margin: 20px auto;
    border-radius: 10px;
    width: 80%;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    text-align: center;
}

/* ⚠️ Titre avec icône */
.low-stock-title {
    font-size: 2rem;
    color: #d9534f;
    font-weight: bold;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
}

/* 🎴 Conteneur des cartes */
.low-stock-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 15px;
    justify-content: center;
    margin-top: 20px;
}

/* 🛒 Carte de produit */
.low-stock-card {
    background: #ffccbc;
    padding: 15px;
    border-radius: 10px;
    text-align: center;
    font-weight: bold;
    color: #5d4037;
    box-shadow: 3px 3px 10px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s, box-shadow 0.3s;
}

/* 🎨 Effet au survol */
.low-stock-card:hover {
    transform: scale(1.05);
    box-shadow: 5px 5px 15px rgba(0, 0, 0, 0.2);
}

/* 📊 Stock restant */
.low-stock-value {
    display: block;
    margin-top: 10px;
    font-size: 1.2rem;
    color: #d84315;
    background: #ffe0b2;
    padding: 5px 10px;
    border-radius: 5px;
}


/* 📱 Responsive */
@media (max-width: 768px) {
    .stats-container {
        padding: 10px;
    }

    .chart-container, .stock-evolution-container, .low-stock-container {
        width: 100%;
        max-width: 100%;
    }

    canvas#statsChart, canvas#stockChart {
        height: 250px !important;
    }
}



</style>
<div class="stats-container">
    <!-- 🎯 Titre Centré -->
    <h1 class="stats-title">📊 Statistiques des Produits</h1>

    <!-- 🔽 Sélecteur Centré -->
    <div class="stats-select-container">
        <label for="chartType">Choisissez le type d'affichage :</label>
        <select id="chartType">
            <option value="bar">📊 Graphique en Barres</option>
            <option value="pie">🟠 Camembert</option>
            <option value="table">📋 Tableau</option>
        </select>
    </div>

    <!-- 📊 Graphique Centré -->
    <div class="chart-container">
        <canvas id="statsChart"></canvas>
    </div>

    <!-- 📋 Tableau Centré -->
    <table id="statsTable" style="display:none;">
        <thead>
            <tr>
                <th>Catégorie</th>
                <th>Nombre de Produits</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
    <div class="stock-evolution-container">
    <h2>🚀 Évolution du Stock</h2>

    <!-- Sélecteur de Produit -->
    <label for="productSelect">Choisissez un produit :</label>
    <select id="productSelect">
        {% for produit in produits %}
            <option value="{{ produit.id }}">{{ produit.nom }}</option>
        {% endfor %}
    </select>

<!-- Graphique en Ligne -->
<canvas id="stockChart"></canvas>
</div>
<!-- 🛑 Conteneur principal -->
<div class="low-stock-container">
    <h3 class="low-stock-title">⚠️ Produits en stock faible</h3>

    <!-- ✅ Vérification de stock faible -->
    {% if lowStockProducts|length > 0 %}
        <div class="low-stock-grid">
            {% for product in lowStockProducts %}
                <div class="low-stock-card">
                    {{ product.nom }}
                    <span class="low-stock-value">Stock restant: {{ product.stock }}</span>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <p>Aucun produit en stock faible 🎉</p>
    {% endif %}
</div>



<!-- Charger Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const chartTypeSelector = document.getElementById("chartType");
    const chartCanvas = document.getElementById("statsChart");
    const tableContainer = document.getElementById("statsTable").querySelector("tbody");

    let chartInstance = null; // Stocke le graphique actuel

    function fetchStats(type) {
        fetch(`/stats/data?type=${type}`)
            .then(response => response.json())
            .then(data => {
                if (type === 'table') {
                    chartCanvas.style.display = 'none';
                    document.getElementById("statsTable").style.display = 'table';
                    updateTable(data.produitsParCategorie);
                } else {
                    document.getElementById("statsTable").style.display = 'none';
                    chartCanvas.style.display = 'block';
                    updateChart(data.produitsParCategorie, type);
                }
            })
            .catch(error => console.error('Erreur lors du chargement des données', error));
    }

    function updateTable(statsData) {
        tableContainer.innerHTML = "";
        statsData.forEach(stat => {
            let row = `<tr><td>${stat.categorie}</td><td>${stat.nombre}</td></tr>`;
            tableContainer.innerHTML += row;
        });
    }

    function updateChart(statsData, type) {
        if (chartInstance) {
            chartInstance.destroy();
        }

        chartInstance = new Chart(chartCanvas, {
            type: type,
            data: {
                labels: statsData.map(stat => stat.categorie),
                datasets: [{
                    label: 'Produits par Catégorie',
                    data: statsData.map(stat => stat.nombre),
                    backgroundColor: ['#4CAF50', '#FF9800', '#F44336', '#3F51B5']
                }]
            }
        });
    }

    // Détecte le changement de type d'affichage
    chartTypeSelector.addEventListener("change", function () {
        fetchStats(this.value);
    });

    // Charger la statistique par défaut (barres)
    fetchStats("bar");
});
document.getElementById("productSelect").addEventListener("change", function() {
    let productId = this.value;
    
    fetch(`/stats/stock-evolution/${productId}`)
        .then(response => response.json())
        .then(data => {
            if (data.length === 0) {
                alert("⚠️ Aucune donnée trouvée pour ce produit !");
                return;
            }

            let labels = data.map(item => new Date(item.date).toLocaleDateString());
            let stockValues = data.map(item => item.stock);

            let ctx = document.getElementById('stockChart').getContext('2d');
            if (window.stockChartInstance) {
                window.stockChartInstance.destroy();
            }
            window.stockChartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Stock',
                        data: stockValues,
                        borderColor: 'blue',
                        backgroundColor: 'rgba(0, 0, 255, 0.2)',
                        borderWidth: 2
                    }]
                }
            });
        })
        .catch(error => console.error("Erreur :", error));
});

document.addEventListener("DOMContentLoaded", function() {
    fetch("/stats/low-stock")
        .then(response => response.json())
        .then(data => {
            let lowStockContainer = document.getElementById("lowStockContainer");

            if (!data || data.length === 0) {
                lowStockContainer.innerHTML = "<p>✅ Aucun produit en stock faible.</p>";
                return;
            }

            let html = "<h3>⚠️ Produits en stock faible</h3><ul>";
            data.forEach(product => {
                if (product.nom && product.stock !== undefined) {
                    html += `<li>${product.nom} - Stock restant: ${product.stock}</li>`;
                } else {
                    console.error("Données invalides reçues :", product);
                }
            });
            html += "</ul>";

            lowStockContainer.innerHTML = html;
        })
        .catch(error => {
            console.error("Erreur lors de la récupération des produits en stock faible :", error);
        });
});


</script>

{% endblock %}
