{% extends 'base.html.twig' %}

{% block title %}Statistiques{% endblock %}

{% block body %}
<style>
/* 🌍 Conteneur principal centré */
.stats-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    padding: 20px;
}

/* 🏷️ Titre Centré */
.stats-title {
    font-size: 2.5rem;
    font-weight: bold;
    color: #2d6a4f;
    text-align: center;
    margin-bottom: 20px;
    width: 100%;
}

/* 🔽 Sélecteur Centré */
.stats-select-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    margin-bottom: 20px;
}

.stats-select-container label {
    font-size: 1.2rem;
    font-weight: bold;
    margin-bottom: 5px;
}

#chartType {
    padding: 10px;
    font-size: 16px;
    border-radius: 5px;
    border: 1px solid #ccc;
    width: 250px;
    text-align: center;
}

/* 📊 Graphique Centré */
.chart-container {
    width: 80%;
    max-width: 600px;
    margin: auto;
    padding: 20px;
}

canvas#statsChart {
    max-width: 100%;
    height: 300px !important;
}

/* 📋 Tableau Centré */
#statsTable {
    width: 80%;
    max-width: 600px;
    margin: auto;
    border-collapse: collapse;
    background: #fff;
    text-align: center;
}

#statsTable th, #statsTable td {
    padding: 10px;
    text-align: center;
    border: 1px solid #ddd;
}

#statsTable th {
    background: #4CAF50;
    color: white;
}

/* 📱 Responsive */
@media (max-width: 768px) {
    .stats-container {
        padding: 10px;
    }

    .chart-container, #statsTable {
        width: 100%;
        max-width: 100%;
    }

    canvas#statsChart {
        height: 250px !important;
    }
}



</style>
<div class="stats-container">
    <!-- 🎯 Titre Centré -->
    <h1 class="stats-title">📊 Statistiques des Produits</h1>

    <!-- 🔽 Sélecteur Centré -->
    <div class="stats-select-container">
        <label for="chartType">Choisissez le type d'affichage :</label>
        <select id="chartType">
            <option value="bar">📊 Graphique en Barres</option>
            <option value="pie">🟠 Camembert</option>
            <option value="table">📋 Tableau</option>
        </select>
    </div>

    <!-- 📊 Graphique Centré -->
    <div class="chart-container">
        <canvas id="statsChart"></canvas>
    </div>

    <!-- 📋 Tableau Centré -->
    <table id="statsTable" style="display:none;">
        <thead>
            <tr>
                <th>Catégorie</th>
                <th>Nombre de Produits</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>


<!-- Charger Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const chartTypeSelector = document.getElementById("chartType");
    const chartCanvas = document.getElementById("statsChart");
    const tableContainer = document.getElementById("statsTable").querySelector("tbody");

    let chartInstance = null; // Stocke le graphique actuel

    function fetchStats(type) {
        fetch(`/stats/data?type=${type}`)
            .then(response => response.json())
            .then(data => {
                if (type === 'table') {
                    chartCanvas.style.display = 'none';
                    document.getElementById("statsTable").style.display = 'table';
                    updateTable(data.produitsParCategorie);
                } else {
                    document.getElementById("statsTable").style.display = 'none';
                    chartCanvas.style.display = 'block';
                    updateChart(data.produitsParCategorie, type);
                }
            })
            .catch(error => console.error('Erreur lors du chargement des données', error));
    }

    function updateTable(statsData) {
        tableContainer.innerHTML = "";
        statsData.forEach(stat => {
            let row = `<tr><td>${stat.categorie}</td><td>${stat.nombre}</td></tr>`;
            tableContainer.innerHTML += row;
        });
    }

    function updateChart(statsData, type) {
        if (chartInstance) {
            chartInstance.destroy();
        }

        chartInstance = new Chart(chartCanvas, {
            type: type,
            data: {
                labels: statsData.map(stat => stat.categorie),
                datasets: [{
                    label: 'Produits par Catégorie',
                    data: statsData.map(stat => stat.nombre),
                    backgroundColor: ['#4CAF50', '#FF9800', '#F44336', '#3F51B5']
                }]
            }
        });
    }

    // Détecte le changement de type d'affichage
    chartTypeSelector.addEventListener("change", function () {
        fetchStats(this.value);
    });

    // Charger la statistique par défaut (barres)
    fetchStats("bar");
});
</script>

{% endblock %}
