{% extends 'front_base.html.twig' %}

{% block title %}Manage Your Schedule{% endblock %}

{% block body %}
    <h1>Manage Your Schedule</h1>

    {{ form_start(form) }}
        {{ form_row(form.startDate) }}
        {{ form_row(form.endDate) }}
        {{ form_row(form.status) }}
        <button class="btn btn-primary">Save</button>
    {{ form_end(form) }}

{% endblock %}
