{% extends 'base_zied.html.twig' %}

{% block title %}Modifier le Post{% endblock %}

{% block body %}

<style>
    .post-form-container {
        max-width: 600px;
        margin: auto;
        padding: 30px;
        background: #fff;
        border-radius: 10px;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
    }

    .post-form h2 {
        font-size: 24px;
        font-weight: bold;
        margin-bottom: 20px;
        color: #333;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .post-form h2 i {
        font-size: 26px;
        color: #ff6b6b;
    }

    .form-group {
        margin-bottom: 15px;
    }

    .form-group label {
        font-weight: 600;
        color: #555;
        display: block;
        margin-bottom: 5px;
    }

    .form-control {
        border-radius: 6px;
        padding: 10px;
        border: 1px solid #ddd;
        width: 100%;
        font-size: 14px;
    }

    .mic-btn {
        background: none;
        border: none;
        cursor: pointer;
        margin-left: 10px;
        font-size: 18px;
        color: #ff6b6b;
    }

    .btn-primary {
        background-color: #9BAB10;
        border: none;
        padding: 12px 15px;
        border-radius: 6px;
        font-weight: 600;
        transition: all 0.3s ease;
        width: 100%;
        margin-top: 10px;
    }

    .btn-primary:hover {
        background-color: #016537;
    }

    .btn-secondary {
        background-color: #eeeeee;
        border: none;
        padding: 10px 15px;
        border-radius: 6px;
        font-weight: 600;
        transition: all 0.3s ease;
        text-align: center;
        display: block;
        margin-top: 15px;
        color: #342E37;
    }

    .btn-secondary:hover {
        background-color: #AAAAAA;
    }

    .btn-danger {
        background-color: #dc3545;
        color: white;
        border: none;
        padding: 10px 15px;
        border-radius: 6px;
        font-weight: 600;
        transition: all 0.3s ease;
        text-align: center;
        display: block;
        margin-top: 15px;
    }

    .btn-danger:hover {
        background-color: #c82333;
    }
</style>

<div class="container mt-4">
    <div class="post-form-container">
        <h2><i class="bx bx-edit"></i> Modifier le Post</h2>

        {{ form_start(form, {'attr': {'class': 'post-form'}}) }}

        <div class="form-group">
            {{ form_label(form.category) }}
            {{ form_widget(form.category, {'attr': {'class': 'form-control'}}) }}
        </div>

        <div class="form-group">
            {{ form_label(form.titre) }}
            <div style="display: flex; align-items: center;">
                {{ form_widget(form.titre, {'attr': {'class': 'form-control titre', 'placeholder': 'Enter post title'}}) }}
                <button type="button" class="mic-btn titre-btn">
                    <i class="bx bx-microphone"></i>
                </button>
            </div>
        </div>

        <div class="form-group">
            {{ form_label(form.contenu) }}
            <div style="display: flex; align-items: center;">
                {{ form_widget(form.contenu, {'attr': {'class': 'form-control contenu', 'placeholder': 'Enter post content'}}) }}
                <button type="button" class="mic-btn contenu-btn">
                    <i class="bx bx-microphone"></i>
                </button>
            </div>
        </div>

        <div class="form-group">
            {{ form_label(form.imageFile) }}
            {{ form_widget(form.imageFile, {'attr': {'class': 'form-control'}}) }}
        </div>

        <button class="btn btn-primary">{{ button_label|default('Update Post') }}</button>

        {{ form_end(form) }}

        <a href="{{ path('app_post_index') }}" class="btn btn-secondary">
            <i class="bx bx-arrow-back"></i> Retourner à la List
        </a>

    </div>
</div>

<script>
    window.onload = function() {
        if (!('webkitSpeechRecognition' in window)) {
            alert('Votre navigateur ne supporte pas la reconnaissance vocale.');
            return;
        }

        let recognition = new webkitSpeechRecognition();
        recognition.lang = 'fr-FR';
        recognition.continuous = false;
        recognition.interimResults = false;
        recognition.maxAlternatives = 1;

        function startSpeechRecognition(fieldClass) {
            let field = document.querySelector(`.${fieldClass}`);
            console.log(`🛠️ Recherche du champ avec la classe : ${fieldClass}`);
            if (!field) {
                console.error("❌ Erreur : Champ introuvable avec la classe :", fieldClass);
                alert("Erreur : Le champ avec la classe " + fieldClass + " est introuvable !");
                return;
            }

            recognition.start();
            console.log("🎤 Reconnaissance vocale activée pour :", fieldClass);

            recognition.onresult = function(event) {
                let transcript = event.results[0][0].transcript;
                console.log("✅ Texte détecté :", transcript);
                if (field) {
                    field.value = transcript;
                    field.dispatchEvent(new Event('input'));
                    console.log("✅ Champ mis à jour avec la classe :", fieldClass, "→", transcript);
                }
            };

            recognition.onerror = function(event) {
                console.error("❌ Erreur de reconnaissance :", event.error);
            };
        }

        // Attendre 1 seconde pour s'assurer que tout est prêt
        setTimeout(function() {
            document.querySelector('.mic-btn.titre-btn').addEventListener('click', function() {
                startSpeechRecognition('titre');
            });

            document.querySelector('.mic-btn.contenu-btn').addEventListener('click', function() {
                startSpeechRecognition('contenu');
            });
        }, 1000);
    };
</script>

{% endblock %}
