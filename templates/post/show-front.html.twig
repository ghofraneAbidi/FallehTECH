{% extends 'base_client.html.twig' %}

{% block title %}{{ post.titre }}{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="card shadow-lg p-4">
       
        <h5 class="mb-3">Category: {{ post.category }}</h5>
        <h2 class="mb-3 text-center">{{ post.titre }}</h2>
        <div class="text-center">
            {% if post.image %}
                <img src="{{ asset('uploads/posts/' ~ post.image) }}" class="card-img-top" alt="{{ post.titre }}" style="height: 600px; object-fit: cover;">
            {% else %}
                <p class="text-muted">No image available</p>
            {% endif %}
        </div>

        <p class="mt-3 text-justify">{{ post.contenu }}</p>
        <button class="btn btn-sm btn-info listen-comment mt-2" data-text="{{ post.contenu }}" style="border-radius: 20px; padding: 10px 20px; font-size: 16px;">
            🎤 Écouter
        </button>

        <!-- Like & Back Button -->
        <div class="d-flex justify-content-between mt-4">
            <form method="POST" action="{{ path('app_post_like', {'id': post.id}) }}">
                <button type="submit" class="btn {% if post.likes|length > 0 %}btn-danger{% else %}btn-outline-danger{% endif %}">
                    <i class="bx bx-heart"></i> Like ({{ post.likes|length }})
                </button>
            </form>

            <a href="{{ path('app_post_front') }}" class="btn btn-secondary">
                <i class="bx bx-arrow-back"></i> Retour aux Posts
            </a>
        </div>

        <!-- Comments Section -->
        <div class="mt-5">
            <h4 class="mb-3">Commentaires</h4>
            <ul class="list-group">
                {% for comment in comments %}
                    <li class="list-group-item">
                        <strong>{{ comment.contenu }}</strong>
                        <br>
                        <small class="text-muted">Posted on {{ comment.date|date('Y-m-d') }}</small>
                        <br>
                        {{ comment.user }}

                        <!-- Listen Button -->
                        <button class="btn btn-sm btn-info listen-comment mt-2" data-text="{{ comment.contenu }}">
                            🎤 Écouter
                        </button>

                        {% if comment.user == app.user %}
                            <div class="mt-2">
                                <a href="{{ path('app_comment_edit', {'id': comment.id}) }}" class="btn btn-sm btn-primary">Edit</a>
                                <form method="POST" action="{{ path('app_comment_delete', {'id': comment.id}) }}" style="display:inline;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ comment.id) }}">
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            </div>
                        {% endif %}
                    </li>
                {% else %}
                    <li class="list-group-item text-muted">Aucun commentaire, sois le premier à répondre!</li>
                {% endfor %}
            </ul>
        </div>

        <!-- Comment Form -->
        <div class="mt-4">
            <h5 class="mb-3">Mets un commentaire</h5>
            <div class="card p-3">
                {{ form_start(commentForm, {'attr': {'novalidate': 'novalidate', 'id': 'commentForm'}}) }}
                    <div class="mb-3">
                        {{ form_widget(commentForm.contenu, {'attr': {'class': 'form-control', 'placeholder': 'Write a comment...'}}) }}
                    </div>
                    <span class="form-error" id="commentError" style="display: none; color: red;"></span>
                    <button type="submit" class="btn btn-success">Commentaire du post</button>
                {{ form_end(commentForm) }}
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function() {
        $('#commentForm').on('submit', function(e) {
            e.preventDefault();
            var commentContent = $('#comment_contenu').val();
    
            // Call the profanity filter API (PurgoMalum)
            $.ajax({
                url: 'https://www.purgomalum.com/service/json?text=' + encodeURIComponent(commentContent),
                type: 'GET',
                success: function(response) {
                    if (commentContent !== response.result) {
                        $('#commentError').text('Your comment contains inappropriate language. Please modify it.').show();
                    } else {
                        $('#commentError').hide();
                        $('#commentForm')[0].submit(); // Submit the form if it's clean
                    }
                },
                error: function() {
                    $('#commentError').text('Error checking comment content. Please try again.').show();
                }
            });
        });

        // Text-to-Voice functionality for each comment
        $('.listen-comment').on('click', function() {
            var text = $(this).data('text');
            var utterance = new SpeechSynthesisUtterance(text);
            utterance.lang = 'fr-FR'; // Set language to French
            speechSynthesis.speak(utterance);
        });
    });
</script>

{% endblock %}
