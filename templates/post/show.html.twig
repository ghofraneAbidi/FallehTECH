{% extends 'base_zied.html.twig' %}

{% block title %}Les detailles des posts{% endblock %}

{% block body %}

<style>
    .post-details-container {
        max-width: 900px;
        margin: auto;
        padding: 20px;
        background: #fff;
        border-radius: 10px;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
    }

    .table-custom {
        width: 100%;
        border-collapse: collapse;
        background: #fff;
        border-radius: 10px;
        overflow: hidden;
    }

    .table-custom thead {
        background: #4CAF50;
        color: white;
    }

    .table-custom th, .table-custom td {
        padding: 15px;
        text-align: left;
        border-bottom: 1px solid #ddd;
    }

    .table-custom th {
        font-weight: bold;
    }

    .table-custom img {
        max-width: 200px;
        border-radius: 8px;
        object-fit: cover;
    }

    .btn-container {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        margin-top: 20px;
    }

    .btn-action {
        flex: 1;
        padding: 12px;
        border-radius: 6px;
        font-weight: bold;
        text-align: center;
        text-decoration: none;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: none;
        cursor: pointer;
    }

    .btn-primary {
        background-color: #4CAF50;
        color: white;
    }

    .btn-primary:hover {
        background-color: #388E3C;
    }

    .btn-secondary {
        background-color: #eeeeee;
        color: #333;
    }

    .btn-secondary:hover {
        background-color: #AAAAAA;
    }

    .btn-danger {
        background-color: #dc3545;
        color: white;
    }

    .btn-danger:hover {
        background-color: #c82333;
    }

    .comments-section {
        margin-top: 30px;
        padding: 20px;
        background: #f9f9f9;
        border-radius: 10px;
    }

    .comments-section h3 {
        font-size: 20px;
        font-weight: bold;
        color: #333;
        margin-bottom: 15px;
    }

    .comment {
        padding: 15px;
        border-radius: 6px;
        background: #fff;
        margin-bottom: 10px;
        border: 1px solid #ddd;
    }

    .comment .comment-date {
        font-size: 12px;
        color: #777;
    }

    .comment .comment-content {
        font-size: 14px;
        color: #333;
        margin-top: 5px;
    }
</style>

<div class="container mt-4">
    <div class="post-details-container">
        <h2 class="text-center" style="color: #4CAF50;"><i class="bx bx-file"></i> Post Details</h2>

        <table class="table-custom">
            <thead>
                <tr>
                    <th colspan="2" class="text-center">Les informations des Posts </th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th>Image</th>
                    <td>
                        {% if post.image %}
                            <img src="{{ asset('uploads/posts/' ~ post.image) }}" alt="{{ post.titre }}">
                        {% else %}
                            <span class="text-muted">No Image</span>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>ID</th>
                    <td>{{ post.id }}</td>
                </tr>
             
                <tr>
                    <th>Category</th>
                    <td>{{ post.category     }}</td>
                </tr>
                <tr>
                    <th>Title</th>
                    <td>{{ post.titre }}</td>
                </tr>
                <tr>
                    <th>Content</th>
                    <td>{{ post.contenu }}</td>
                </tr>
                <tr>
                    <th>Date</th>
                    <td>{{ post.date ? post.date|date('Y-m-d') : '-' }}</td>
                </tr>
                <tr>
                    <th>Likes</th>
                    <td>❤️ {{ post.likes|length }}</td>
                </tr>
            </tbody>
        </table>

        <div class="btn-container">
            <a href="{{ path('app_post_index') }}" class="btn-action btn-secondary">
                <i class="bx bx-arrow-back"></i> Retour a la liste
            </a>

            {% if post.user == app.user %}
                <a href="{{ path('app_post_edit', {'id': post.id}) }}" class="btn-action btn-primary">
                    <i class="bx bx-edit"></i> Modifier Post
                </a>

                <form method="post" action="{{ path('app_post_delete', {'id': post.id}) }}" 
                    onsubmit="return confirm('Are you sure you want to delete this post?');"
                    style="flex: 1;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}">
                    <button type="submit" class="btn-action btn-danger">
                        <i class="bx bx-trash"></i> Supprimer
                    </button>
                </form>
            {% endif %}
        </div>

        <!-- Comments Section -->
        <div class="comments-section">
            <h3>📝 Commentaires ({{ comments|length }})</h3>

            {% if comments %}
                {% for comment in comments %}
                    <div class="comment">
                        <strong>{{ comment.user ? comment.user.name : 'Anonymous' }}</strong>
                        <br>
                        <span class="comment-date">📅 {{ comment.date|date('Y-m-d') }}</span>
                        <p class="comment-content">{{ comment.contenu }}</p>
                    </div>
                {% endfor %}
            {% else %}
                <p class="text-muted">No comments available.</p>
            {% endif %}
        </div>

    </div>
</div>

{% endblock %}