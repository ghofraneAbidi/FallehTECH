{% extends 'base_zied.html.twig' %}

{% block title %}BACKOFFICE{% endblock %}

{% block body %}
<style>
    .container {
        max-width: 1200px;
        margin: auto;
    }

    h2 {
        color: #2d6a4f;
        font-weight: bold;
        text-align: center;
        margin-bottom: 30px;
    }

    .btn-toggle-stats, .btn-create {
        padding: 10px 15px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: bold;
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
    }

    .btn-toggle-stats {
        background: #66bb6a;
        color: #fff;
    }

    .btn-toggle-stats:hover {
        background: #388e3c;
        transform: translateY(-3px);
    }

    .btn-create {
        background: #007bff;
        color: #fff;
        margin-left: 20px;
    }

    .btn-create:hover {
        background: #0056b3;
        transform: translateY(-3px);
    }

    .button-container {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin: 20px 0;
    }

    #statsSection {
        max-width: 800px;
        margin: 40px auto;
        background: #ffffff;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0px 8px 16px rgba(0, 0, 0, 0.1);
    }

    #statsSection h3 {
        color: #388e3c;
        margin-bottom: 20px;
    }

    .stats-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

    .stats-table th, .stats-table td {
        padding: 12px 15px;
        text-align: center;
        border: 1px solid #e0e0e0;
    }

    .stats-table th {
        background-color: #66bb6a;
        color: white;
        font-weight: bold;
    }

    .stats-table tbody tr:nth-child(even) {
        background-color: #f5f5f5;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

    table th, table td {
        padding: 12px 15px;
        text-align: center;
        border: 1px solid #e0e0e0;
    }

    table th {
        background-color: #66bb6a;
        color: white;
        font-weight: bold;
    }

    table tbody tr:nth-child(even) {
        background-color: #f5f5f5;
    }

    #searchInputBack {
        margin: 20px 0;
        width: 50%;
        padding: 10px;
        border: 2px solid #66bb6a;
        border-radius: 8px;
        font-size: 16px;
        outline: none;
        display: block;
        margin-left: auto;
        margin-right: auto;
    }

    #searchInputBack:focus {
        border-color: #388e3c;
    }
</style>

<div class="container mt-4">
    <div class="card shadow-lg p-4">
        <div class="card-header text-center">
            <h2>🌿 Gestion des Posts - BackOffice 📚</h2>
        </div>

        <div class="card-body">
            <div class="button-container">
                <button class="btn-toggle-stats" onclick="toggleStats()">Afficher/Masquer Statistiques</button>
                <a href="{{ path('app_post_new') }}" class="btn-create">
                    <i class="fas fa-plus"></i> Créer un nouveau
                </a>
            </div>

            <div id="statsSection" class="text-center mb-4" style="display: none;">
                <h3>📊 Statistiques des Posts par Catégorie 🌱</h3>
                <table class="stats-table">
                    <thead>
                        <tr>
                            <th>Catégorie</th>
                            <th>Nombre de Posts</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for category, count in categoryStats %}
                            <tr>
                                <td>{{ category }}</td>
                                <td>{{ count }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="2" class="text-muted">Aucune statistique disponible.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <input type="text" id="searchInputBack" placeholder="Rechercher des posts..." onkeyup="searchPostsBack()">

            <table>
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Titre</th>
                        <th>Catégorie</th>
                        <th>Contenu</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="postsContainerBack">
                    {% for post in posts %}
                        <tr>
                            <td><img src="{{ asset('uploads/posts/' ~ post.image) }}" alt="{{ post.titre }}" style="width: 100px; height: 60px; object-fit: cover;"></td>
                            <td>{{ post.titre }}</td>
                            <td>{{ post.category }}</td>
                            <td>{{ post.contenu | slice(0, 50) }}...</td>
                            <td>{{ post.date ? post.date|date('Y-m-d') : '-' }}</td>
                            <td>
                                <a href="{{ path('app_post_show', {'id': post.id}) }}" class="btn btn-success btn-sm">👁 Voir</a>
                                <a href="{{ path('app_post_edit', {'id': post.id}) }}" class="btn btn-warning btn-sm">✏ Modifier</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center text-muted">Aucun post trouvé.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function toggleStats() {
        let statsSection = document.getElementById('statsSection');
        statsSection.style.display = statsSection.style.display === 'none' ? 'block' : 'none';
    }

    function searchPostsBack() {
        let input = document.getElementById('searchInputBack').value;
        let postsContainer = document.getElementById('postsContainerBack');

        fetch('{{ path('app_post_search_ajax') }}?q=' + encodeURIComponent(input))
            .then(response => response.json())
            .then(data => {
                postsContainer.innerHTML = '';

                if (data.length === 0) {
                    postsContainer.innerHTML = '<tr><td colspan="6" class="text-center text-muted">Aucun post trouvé.</td></tr>';
                    return;
                }

                data.forEach(post => {
                    let row = `
                        <tr>
                            <td><img src="/uploads/posts/${post.image}" alt="${post.titre}" style="width: 100px; height: 60px; object-fit: cover;"></td>
                            <td>${post.titre}</td>
                            <td>${post.category}</td>
                            <td>${post.contenu}</td>
                            <td>${post.date}</td>
                            <td>
                                <a href="/post/${post.id}" class="btn btn-success btn-sm">👁 Voir</a>
                                <a href="/post/${post.id}/edit" class="btn btn-warning btn-sm">✏ Modifier</a>
                            </td>
                        </tr>
                    `;
                    postsContainer.innerHTML += row;
                });
            })
            .catch(error => console.error('Erreur:', error));
    }
</script>

{% endblock %}
