{% extends 'base_client.html.twig' %}

{% block title %}Les posts{% endblock %}

{% block body %}
<style>
    /* 🌾 Arrière-plan avec effet de parallaxe */
    body {
        background: url("https://source.unsplash.com/1920x1080/?farm,field,organic") no-repeat center center fixed;
        background-size: cover;
        position: relative;
    }

    body::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgb(254, 254, 254); /* Vert plus naturel et élégant */
        z-index: -1;
    }

    /* 📜 Conteneur principal */
    .container {
        max-width: 1200px;
        margin: auto;
        padding: 30px;
        animation: fadeIn 1s ease-in-out;
    }

    /* ✨ Effet d’apparition */
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* 🌿 Titre principal */
    .forum-title {
        color:rgb(84, 142, 100); /* Vert très clair pour contraste */
        text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.5);
        font-size: 2.7rem;
        font-weight: bold;
        text-align: center;
        margin-bottom: 20px;
    }

    /* 📢 Description */
    .forum-description {
        background: rgba(255, 255, 255, 0.15);
        padding: 20px;
        border-radius: 12px;
        backdrop-filter: blur(8px);
        color:rgb(92, 133, 101);
        font-size: 1.2rem;
        text-align: center;
        font-weight: bold;
        margin-bottom: 30px;
    }

    /* 🏞 Cartes */
    .card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        border-radius: 12px;
        transition: all 0.3s ease-in-out;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);
        overflow: hidden;
    }

    .card:hover {
        transform: translateY(-5px) scale(1.02);
        box-shadow: 0px 6px 15px rgba(0, 0, 0, 0.25);
    }

    .card img {
        border-radius: 12px 12px 0 0;
        height: 200px;
        object-fit: cover;
        transition: transform 0.3s ease-in-out;
    }

    .card:hover img {
        transform: scale(1.05);
    }

    /* 🟢 Texte de la carte */
    .card-title {
        color: #2d6a4f;
        font-weight: bold;
    }

    .card-category {
        font-size: 0.9rem;
        color: #205b40; /* Vert légèrement plus foncé */
        font-weight: bold;
    }

    /* 💖 Bouton "Like" avec effet */
    .btn-like {
        background: linear-gradient(to right, #4caf50, #2d6a4f);
        color: white;
        transition: all 0.3s ease-in-out;
        font-weight: bold;
        border-radius: 8px;
        box-shadow: 0px 3px 8px rgba(0, 0, 0, 0.2);
    }

    .btn-like:hover {
        background: linear-gradient(to right, #388e3c, #1b5e20);
        transform: scale(1.1);
    }

    /* Effet pulsation au clic */
    .btn-like:active {
        animation: pulse 0.3s;
    }

    @keyframes pulse {
        0% { transform: scale(1); }
        50% { transform: scale(1.1); }
        100% { transform: scale(1); }
    }

    .pagination-container {
        display: flex;
        justify-content: center;
        margin-top: 20px;
    }

    .pagination-container .btn-pagination {
        background: #4caf50;
        color: white;
        font-weight: bold;
        border-radius: 8px;
        padding: 10px 15px;
        margin: 5px;
        transition: all 0.3s ease-in-out;
        text-decoration: none;
    }

    .pagination-container .btn-pagination:hover {
        background: #388e3c;
        transform: scale(1.1);
    }

    /* 🔍 Bouton "Voir plus" */
    .btn-view {
        background: linear-gradient(to right, #66bb6a, #43a047);
        color: white;
        font-weight: bold;
        border-radius: 8px;
        transition: all 0.3s ease-in-out;
    }

    .btn-view:hover {
        background: linear-gradient(to right, #4caf50, #2e7d32);
        transform: scale(1.1);
    }

    /* 📅 Date */
    .post-date {
        font-size: 0.9rem;
        color: #6c757d;
        text-align: center;
    }

     /* 🌦️ Bouton Météo */
    .btn-meteo {
        display: block;
        width: max-content;
        margin: auto;
        background: linear-gradient(to right, #0099cc, #0056b3);
        color: white;
        font-weight: bold;
        border-radius: 8px;
        padding: 10px 15px;
        transition: all 0.3s ease-in-out;
        text-decoration: none;
    }

    .btn-meteo:hover {
        background: linear-gradient(to right, #007acc, #003f7f);
        transform: scale(1.1);
    }

    /* 🔄 Pagination */
    .pagination {
        margin-top: 20px;
    }
</style>

<div class="container mt-4">
    <h1 class="forum-title">🌿 Forum des Clients - Agriculture Intelligente 🌿</h1>

    <p class="forum-description">
         Rejoignez notre communauté agricole ! Posez vos questions, partagez votre expérience et échangez avec d’autres passionnés de l’agriculture durable . 
    </p>
 
    
    <!-- 🌦️ Bouton Voir la Météo -->
<div class="text-center mb-4">
    <a href="{{ path('app_weather') }}" class="btn btn-info btn-lg">
        🌦️ Voir la Météo
    </a>
</div>



    <!-- Best Posts Section -->
    <h2 class="text-center text-warning my-4">🌟 Top 3 Meilleurs Posts 🌟</h2>
    <div class="row">
        {% for post in bestPosts %}
        <div class="col-md-4 mb-4">
            <div class="card">
                <img src="{{ asset('uploads/posts/' ~ post.image) }}" class="card-img-top" alt="{{ post.titre }}">
                <div class="card-body">
                    <h6 class="card-category">{{ post.category }}</h6>
                    <h5 class="card-title">{{ post.titre }}</h5>
                    <p class="card-text text-muted">{{ post.contenu | slice(0, 100) }}...</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="badge bg-success">👍 {{ post.likes|length }} | 💬 {{ post.comments|length }}</span>
                        <a href="{{ path('app_post_show_front', {'id': post.id}) }}" class="btn btn-view">
                            🔎 Voir plus
                        </a>
                    </div>
                </div>
            </div>
        </div>
        {% else %}
        <p class="text-center text-muted">Aucun post populaire trouvé.</p>
        {% endfor %}
    </div>
  
    <!-- All Posts Section -->
    <h2 class="text-center my-4" style="color: #2d6a4f; font-weight: bold;">Tous les posts 🌱</h2>
    <!-- Filter by Category -->
    <form method="GET" action="{{ path('app_post_front') }}" class="mb-4 text-center">
        <label for="category" class="fw-bold">Filtrer par catégorie :</label>
        <select name="category" id="category" class="form-select d-inline-block w-auto" onchange="this.form.submit()">
            <option value="">Toutes les catégories</option>
            {% for cat in categories %}
                <option value="{{ cat.category }}" {% if selectedCategory == cat.category %}selected{% endif %}>
                    {{ cat.category }}
                </option>
            {% endfor %}
        </select>
    </form>
    <div class="row">
        {% for post in pagination.items %}
        <div class="col-md-4 mb-4">
            <div class="card">
                <img src="{{ asset('uploads/posts/' ~ post.image) }}" class="card-img-top" alt="{{ post.titre }}">
                <div class="card-body">
                    <h6 class="card-category">{{ post.category }}</h6>
                    <h5 class="card-title">{{ post.titre }}</h5>
                    <p class="card-text text-muted">{{ post.contenu | slice(0, 100) }}...</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <form method="POST" action="{{ path('app_post_like', {'id': post.id}) }}">
                            <button type="submit" class="btn btn-like">
                                ❤️ Like ({{ post.likes|length }})
                            </button>
                        </form>
                        <a href="{{ path('app_post_show_front', {'id': post.id}) }}" class="btn btn-view">
                            🔎 Voir plus
                        </a>
                    </div>
                </div>
                <div class="card-footer bg-light text-center py-2">
                    <small class="post-date">📅 Posté le {{ post.date|date('F j, Y') }}</small>
                </div>
            </div>
        </div>
        {% else %}
        <p class="text-center text-muted">Aucun post disponible pour le moment.</p>
        {% endfor %}
    </div>

    <!-- Pagination controls -->
    <div class="pagination-container">
        <a href="{{ path('app_post_front', {'page': 1}) }}" class="btn btn-pagination">1</a>
        <a href="{{ path('app_post_front', {'page': 2}) }}" class="btn btn-pagination">2</a>
    </div>
</div>
{% endblock %}
