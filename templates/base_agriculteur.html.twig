<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>{% block title %}Farm Manager - Agricultor Dashboard{% endblock %}</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="Farm Management" name="keywords">
    <meta content="Dashboard for managing farm products" name="description">

    <!-- ✅ Bootstrap & FontAwesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
<!-- ✅ Ajout de Bootstrap 5 pour un meilleur style -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<!-- Bootstrap JS (Latest Version) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- ✅ Custom Styles -->
    <link href="{{ asset('sarahcss/bootstrap.min.css') }}" rel="stylesheet">
    <link href="{{ asset('sarahcss/style.css') }}" rel="stylesheet">
</head>

<body>

    <!-- ✅ NAVBAR START -->
    <nav class="navbar navbar-expand-lg bg-success navbar-dark shadow-sm py-3 px-3">
        <a href="#" class="navbar-brand">
            <img src="{{ asset('img/logo.png') }}" alt="FarmFresh Logo" class="logo">
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
            <span class="navbar-toggler-icon"></span>
        </button>

         <!-- Navbar Items -->
    <div class="collapse navbar-collapse justify-content-center" id="navbarCollapse">
        <div class="navbar-nav mx-auto py-0">
            <a href="/" class="nav-item nav-link active">Home</a>
            <a href="about.html" class="nav-item nav-link">About</a>
              <a href="{{ path('app_ouvrier_offers') }}" class="nav-item nav-link">offre de travail</a>
            <a href="{{ path('app_post_front') }}" class="nav-item nav-link">Posts</a>
            <a href="{{ path('agriculteur_index') }}" class="nav-item nav-link">Produits</a> <!-- ✅ Products Page -->
        </div>
    </div>

      
    </nav>
    <!-- ✅ NAVBAR END -->

    <!-- ✅ MAIN CONTENT -->
    <main class="container my-5">
        {% block body %}{% endblock %}
    </main>

    <!-- ✅ NOTIFICATION BARS -->
    <div id="productNotification" class="alert alert-success d-none position-fixed top-0 start-50 translate-middle-x mt-3 shadow-lg"
         style="z-index: 1050; width: 300px; text-align: center;">
        <i class="fa fa-check-circle"></i> Produit ajouté avec succès !
    </div>

    <div id="favoritesNotification" class="alert alert-info d-none position-fixed top-0 start-50 translate-middle-x mt-3 shadow-lg"
         style="z-index: 1050; width: 300px; text-align: center;">
        <i class="fa fa-user"></i> Liste des favoris mise à jour !
    </div>

    <!-- ✅ JavaScript -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            function updateFavoritesCounter() {
                // Fetch total count of all favorite lists (grouped by clients)
                fetch('/favorites/count-clients')
                    .then(response => response.json())
                    .then(data => {
                        document.getElementById('favorisCount').textContent = data.count || 0;
                    });
            }

            function showNotification(type) {
                const notification = type === 'product' ? document.getElementById('productNotification') : document.getElementById('favoritesNotification');
                notification.classList.remove('d-none');
                setTimeout(() => {
                    notification.classList.add('d-none');
                }, 3000);
            }

            // ➕ Add Product Button Notification
            document.querySelector('.icon-btn .fa-plus').addEventListener('click', function () {
                showNotification('product');
            });

            updateFavoritesCounter(); // Load initial favorites counter
        });
    </script>

</body>
</html>
