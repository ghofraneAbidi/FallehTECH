<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.fx.MainController"
            fx:id="rootLayout"
            stylesheets="@../styles/sidebardash.css">

    <!-- SIDEBAR -->
    <left>
        <VBox fx:id="sidebar"
              prefWidth="240"
              spacing="10"
              style="-fx-background-color: #b6d7a8; -fx-padding: 20;">
            <children>
                <VBox spacing="10" alignment="CENTER">
                    <ImageView fx:id="profileImage"
                               fitHeight="100"
                               fitWidth="100"
                               preserveRatio="true"
                               style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 4, 0.3, 0, 1);" />
                    <Label text="Sarah" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox spacing="5">
                    <Button fx:id="btnCategories" onAction="#goToCategories" styleClass="sidebar-button" text="📦 Catégories"/>
                    <Button fx:id="btnSousCategories" onAction="#goToSousCategories" styleClass="sidebar-button" text="📂 Sous-Catégories"/>
                    <Button fx:id="btnProduits" onAction="#goToProduits" styleClass="sidebar-button" text="🛒 Produits"/>

                    <!-- 🎨 Boutons décoratifs -->
                    <Button styleClass="sidebar-button" text="📦 Commandes"/>
                    <Button styleClass="sidebar-button" text="📝 Blog"/>
                    <Button styleClass="sidebar-button" text="💼 Offres"/>
                </VBox>
            </children>
        </VBox>
    </left>

    <!-- NAVBAR -->
    <top>
        <HBox styleClass="navbar" spacing="10" alignment="CENTER_LEFT">
            <children>
                <Button fx:id="toggleSidebarBtn" text="☰" onAction="#toggleSidebar" styleClass="toggle-button"/>
                <Label fx:id="navTitle" text="App Navigation" styleClass="navbar-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="notificationBtn" text="🔔" styleClass="icon-button"/>
                <MenuButton fx:id="profileMenu" text="👤 Sarah ▼" styleClass="profile-menu">
                    <items>
                        <MenuItem text="Profil"/>
                        <MenuItem text="Déconnexion"/>
                    </items>
                </MenuButton>
            </children>
        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <AnchorPane fx:id="mainContent"/>
    </center>

</BorderPane>
