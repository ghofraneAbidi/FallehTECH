<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.fx.AjouterCategorieController"
            prefWidth="400" prefHeight="300"
            stylesheets="@../styles/agri-style.css">

    <VBox spacing="10" alignment="TOP_CENTER" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10"
          AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">

        <padding>
            <Insets top="15" bottom="15" left="15" right="15"/>
        </padding>

        <!-- ✅ Notification centrée en haut -->
        <HBox alignment="CENTER">
            <Label fx:id="notifLabel"
                   visible="false"
                   wrapText="true"
                   maxWidth="300"
                   styleClass="notif-label warning"
                   alignment="CENTER"/>
        </HBox>

        <!-- Le reste du contenu -->
        <Label text="➕ Nouvelle Catégorie" styleClass="form-title"/>
        <TextField fx:id="nomField" promptText="Nom de la catégorie"/>

        <HBox spacing="10" alignment="CENTER">
            <Button text="Choisir Image" onAction="#choisirImage"/>
            <Button text="Prendre Photo" onAction="#prendrePhoto"/>
        </HBox>

        <ImageView fx:id="imagePreview" fitWidth="120" fitHeight="90" preserveRatio="true"
                   style="-fx-border-color: lightgray;"/>

        <HBox spacing="10" alignment="CENTER">
            <Button text="Ajouter" onAction="#ajouterCategorie" styleClass="add-button"/>
            <Button text="Annuler" onAction="#fermerFenetre" styleClass="cancel-button"/>
        </HBox>
    </VBox>

</AnchorPane>
